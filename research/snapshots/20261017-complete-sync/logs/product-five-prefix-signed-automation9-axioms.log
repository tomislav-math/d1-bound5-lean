D1Bound5.mixed_signed_root_det_upper_33_128.{u_1} {R : Type u_1} [CommRing R] (f : R →+* ℂ) (a : Fin 4 → R)
  (u : Fin 4 → ℂ) (S : Matrix (Fin 4) (Fin 4) R) (hu : ∀ (i : Fin 4), u i ^ 2 = f (a i))
  (hdiag : ∀ (i : Fin 4), S i i = a i) (hsymm : ∀ (i j : Fin 4), S i j = S j i)
  (hgood : ∀ (i j : Fin 4), i ≠ j → D1Bound5.MixedSignedEntryGood f a u i j (S i j)) :
  ‖(D1Bound5.normalizedRootError (fun i => f (a i)) u fun i j => f (S i j)).det‖ < 33 / 128
