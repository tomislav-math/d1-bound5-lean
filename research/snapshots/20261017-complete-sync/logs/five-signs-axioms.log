@D1Bound5.signedEntryBounds_fiftyfour_or_neg : ∀ {R : Type u_1} [inst : CommRing R] (f : R →+* ℂ) (a b r : R) (u v : ℂ),
  u ^ 2 = f a →
    v ^ 2 = f b →
      r ^ 2 = a * b + 1 →
        54 ≤ ‖f a * f b‖ →
          D1Bound5.SignedEntryBounds f a b u v r (50 / 99) (625 / 264627) ∨
