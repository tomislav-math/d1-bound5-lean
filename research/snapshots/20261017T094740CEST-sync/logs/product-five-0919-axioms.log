@D1Bound5.IsD1Tuple.productFive_growth : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (a : Fin 5 → NumberField.RingOfIntegers K),
      D1Bound5.IsD1Tuple a →
        (Monotone fun i => ‖phi ↑(a i)‖) → 3 ≤ ‖phi ↑(a 1)‖ → 3 * ∏ i, ‖phi ↑(a (Fin.castAdd 1 i))‖ < ‖phi ↑(a 4)‖
