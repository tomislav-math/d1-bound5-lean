        (Monotone fun i => ‖phi ↑(a i)‖) →
          3 ≤ ‖phi ↑(a 1)‖ →
            ∀ (u : Fin 5 → ℂ) (S : Matrix (Fin 5) (Fin 5) (NumberField.RingOfIntegers K)),
              (∀ (i : Fin 5), u i ^ 2 = phi ↑(a i)) →
                (∀ (i : Fin 5), S i i = a i) →
                  (∀ (i j : Fin 5), S i j = S j i) →
                    (∀ (i j : Fin 5),
