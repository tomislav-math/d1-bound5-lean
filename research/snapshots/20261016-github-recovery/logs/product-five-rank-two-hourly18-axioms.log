                        (Mathlib.Tactic.Ring.Common.neg_add
                          (Mathlib.Tactic.Ring.Common.neg_mul p (Nat.rawCast 1)
                            (Mathlib.Tactic.Ring.Common.neg_mul h (Nat.rawCast 1)
                              (Mathlib.Meta.NormNum.IsInt.to_raw_eq
                                (Mathlib.Meta.NormNum.isInt_neg (Eq.refl Neg.neg)
                                  (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.IsNat.of_raw ℂ 1))
                                  (Eq.refl (Int.negOfNat 1))))))
                          Mathlib.Tactic.Ring.Common.neg_zero))
                      (Mathlib.Tactic.Ring.Common.add_pf_add_lt
                        (d ^ Nat.rawCast 1 * (k ^ Nat.rawCast 1 * (h ^ Nat.rawCast 1 * Nat.rawCast 1)))
                        (Mathlib.Tactic.Ring.Common.add_pf_add_lt
                          (d ^ Nat.rawCast 1 * (p ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast))
                          (Mathlib.Tactic.Ring.Common.add_pf_add_gt (⋯ ^ ⋯ * ⋯) ⋯)))))
                  ⋯)))))))
theorem D1Bound5.productFiveSchur_det : ∀ (F : Matrix (Fin 4) (Fin 4) ℂ) (f w : Fin 4 → ℂ) (d : ℂ),
  F.det ≠ 0 →
    d ≠ 0 →
      F.transpose = F →
        (D1Bound5.productFiveSchur F f w d).det =
          F.det *
            (1 - 2 * f ⬝ᵥ F⁻¹.mulVec w / d +
              ((f ⬝ᵥ F⁻¹.mulVec w) ^ 2 - f ⬝ᵥ F⁻¹.mulVec f * w ⬝ᵥ F⁻¹.mulVec w - f ⬝ᵥ F⁻¹.mulVec f) / d ^ 2) :=
fun F f w d hF hd hsym =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          _a.det =
            F.det *
              (1 - 2 * f ⬝ᵥ F⁻¹.mulVec w / d +
                ((f ⬝ᵥ F⁻¹.mulVec w) ^ 2 - f ⬝ᵥ F⁻¹.mulVec f * w ⬝ᵥ F⁻¹.mulVec w - f ⬝ᵥ F⁻¹.mulVec f) / d ^ 2))
        (D1Bound5.productFiveSchur_eq F f w d)))
    (D1Bound5.productFive_rankTwo_det_symmetric F f w d hF hd hsym)
