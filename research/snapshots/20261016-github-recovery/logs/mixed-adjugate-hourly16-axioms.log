theorem D1Bound5.mixed_signed_root_det_and_adjugate_upper.{u_1} : ∀ {R : Type u_1} [inst : CommRing R] (f : R →+* ℂ)
  (a : Fin 4 → R) (u : Fin 4 → ℂ) (S : Matrix (Fin 4) (Fin 4) R),
  (∀ (i : Fin 4), u i ^ 2 = f (a i)) →
    (∀ (i : Fin 4), S i i = a i) →
      (∀ (i j : Fin 4), S i j = S j i) →
        (∀ (i j : Fin 4), i ≠ j → D1Bound5.MixedSignedEntryGood f a u i j (S i j)) →
          ‖(D1Bound5.normalizedRootError (fun i => f (a i)) u fun i j => f (S i j)).det‖ < 3 / 10 ∧
            ‖(D1Bound5.normalizedRootError (fun i => f (a i)) u fun i j => f (S i j)).adjugate‖ <
              155 / 96 * (59 / 96) ^ 2 :=
fun {R} [CommRing R] f a u S hu hdiag hsymm hgood =>
  ⟨D1Bound5.mixed_signed_root_det_upper f a u S hu hdiag hsymm hgood,
    D1Bound5.mixed_signed_root_adjugate_upper f a u S hu hdiag hsymm hgood⟩
