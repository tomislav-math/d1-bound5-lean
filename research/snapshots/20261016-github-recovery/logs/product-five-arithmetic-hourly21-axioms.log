D1Bound5.full_ring_productFive_arithmetic_growth.{u_1} {K : Type u_1} [Field K] [NumberField K]
  [NumberField.IsTotallyComplex K] (hK : Module.finrank ℚ K = 2) (phi : K →+* ℂ)
  (a : Fin 5 → NumberField.RingOfIntegers K) (M : Matrix (Fin 5) (Fin 5) (NumberField.RingOfIntegers K)) (u : Fin 5 → ℂ)
  (hu : ∀ (i : Fin 5), u i ^ 2 = phi ↑(a i)) (hdiag : ∀ (i : Fin 5), M i i = a i)
  (hsym : ∀ (i j : Fin 5), M i j = M j i) (hd : (D1Bound5.fiveLastValue fun i => phi ↑(a i)) ≠ 0)
  (hGne :
    (D1Bound5.fiveNormalizedSchur (fun i => phi ↑(a i)) u
          (M.map ⇑(phi.comp (algebraMap (NumberField.RingOfIntegers K) K)))).det ≠
      0)
  (hGlt :
    ‖(D1Bound5.fiveNormalizedSchur (fun i => phi ↑(a i)) u
            (M.map ⇑(phi.comp (algebraMap (NumberField.RingOfIntegers K) K)))).det‖ <
      1 / 3) :
  3 * ∏ i, ‖phi ↑(a (Fin.castAdd 1 i))‖ < ‖phi ↑(a 4)‖
