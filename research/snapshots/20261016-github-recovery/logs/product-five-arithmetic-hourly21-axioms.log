D1Bound5.five_root_det_ne_zero_of_schur (t u : Fin 5 → ℂ) (M : Matrix (Fin 5) (Fin 5) ℂ)
  (hu : ∀ (i : Fin 5), u i ^ 2 = t i) (hdiag : ∀ (i : Fin 5), M i i = t i) (hsym : M.transpose = M)
  (hd : D1Bound5.fiveLastValue t ≠ 0) (hG : (D1Bound5.fiveNormalizedSchur t u M).det ≠ 0) : M.det ≠ 0
