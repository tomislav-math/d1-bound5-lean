theorem D1Bound5.IsD1Tuple.productFour_mixed_growth.{u_1} : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 4 → NumberField.RingOfIntegers K),
      D1Bound5.IsD1Tuple t →
        (Monotone fun i => ‖phi ↑(t i)‖) →
          1 ≤ ‖phi ↑(t 0)‖ → 3 ≤ ‖phi ↑(t 1)‖ → 3 / 2 * ‖phi ↑(t 0)‖ * ‖phi ↑(t 1)‖ * ‖phi ↑(t 2)‖ < ‖phi ↑(t 3)‖ :=
fun {K} [Field K] [NumberField K] [NumberField.IsTotallyComplex K] hK phi t ht hmon hA hB =>
  Exists.casesOn (D1Bound5.IsD1Tuple.exists_symmetric_root_matrix t ht) fun M h =>
    And.casesOn h fun hdiag right =>
      And.casesOn right fun hsymm hroot =>
        have htail := (D1Bound5.IsD1Tuple.tail_irregular_and_growth hK phi t ht hmon hB).right;
        D1Bound5.full_ring_productFour_mixed_growth hK phi t M hdiag hsymm hroot hmon hA hB htail
