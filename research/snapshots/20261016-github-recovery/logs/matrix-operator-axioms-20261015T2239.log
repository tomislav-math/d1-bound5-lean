'D1Bound5.four_zero_diagonal_operator_norm_lt' depends on axioms: [propext, Classical.choice, Quot.sound]
'D1Bound5.signed_root_matrix_operator_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
'D1Bound5.exists_signed_root_matrix_operator_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
D1Bound5.four_zero_diagonal_operator_norm_lt : ∀ (E : Matrix (Fin 4) (Fin 4) ℂ) (δ : ℝ),
  0 < δ → (∀ (i : Fin 4), E i i = 0) → (∀ (i j : Fin 4), i ≠ j → ‖E i j‖ < δ) → ‖E‖ < 3 * δ
@D1Bound5.signed_root_matrix_operator_bound : ∀ {R : Type u_1} [inst : CommRing R] (f : R →+* ℂ) (a : Fin 4 → R)
  (u : Fin 4 → ℂ) (S : Matrix (Fin 4) (Fin 4) R),
  (∀ (i : Fin 4), u i ^ 2 = f (a i)) →
    (∀ (i : Fin 4), S i i = a i) →
      (∀ (i j : Fin 4), i ≠ j → D1Bound5.SignedEntryGood f (a i) (a j) (u i) (u j) (S i j)) →
        ‖(D1Bound5.normalizedRootError (fun i => f (a i)) u fun i j => f (S i j)) - D1Bound5.halfOffDiagonal‖ <
          3 * (128 / 8649)
@D1Bound5.exists_signed_root_matrix_operator_bound : ∀ {R : Type u_1} [inst : CommRing R] (f : R →+* ℂ) (a : Fin 4 → R)
  (M : Matrix (Fin 4) (Fin 4) R),
  (∀ (i : Fin 4), M i i = a i) →
    (∀ (i j : Fin 4), M i j = M j i) →
      (∀ (i j : Fin 4), i ≠ j → M i j ^ 2 = a i * a j + 1) →
        (∀ (i j : Fin 4), i ≠ j → 9 ≤ ‖f (a i) * f (a j)‖) →
          ∃ u S,
            (∀ (i : Fin 4), u i ^ 2 = f (a i)) ∧
              (∀ (i : Fin 4), S i i = a i) ∧
                (∀ (i j : Fin 4), S i j = S j i) ∧
                  (∀ (i j : Fin 4), i ≠ j → S i j = M i j ∨ S i j = -M i j) ∧
                    (∀ (i j : Fin 4), i ≠ j → S i j ^ 2 = a i * a j + 1) ∧
                      ‖(D1Bound5.normalizedRootError (fun i => f (a i)) u fun i j => f (S i j)) -
                            D1Bound5.halfOffDiagonal‖ <
                        3 * (128 / 8649)
