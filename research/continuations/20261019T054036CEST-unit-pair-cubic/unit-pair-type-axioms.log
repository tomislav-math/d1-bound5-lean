UNIT_PAIR_AXIOMS_PASS D1Bound5.unit_pair_cancellation_norm: [propext, Classical.choice, Quot.sound]
UNIT_PAIR_AXIOMS_PASS D1Bound5.discrete_unit_pair_cubic_growth: [propext, Classical.choice, Quot.sound]
UNIT_PAIR_AXIOMS_PASS D1Bound5.full_ring_unit_pair_cubic_growth: [propext, Classical.choice, Quot.sound]
