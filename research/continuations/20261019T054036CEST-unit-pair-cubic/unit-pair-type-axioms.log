UNIT_PAIR_AXIOMS_PASS D1Bound5.unit_pair_cubic_root_margin: [propext, Classical.choice, Quot.sound]
UNIT_PAIR_AXIOMS_PASS D1Bound5.unit_pair_cubic_numeric: [propext, Classical.choice, Quot.sound]
