@D1Bound5.IsD1Tuple.unit_pair_finite_field_model : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 6 → NumberField.RingOfIntegers K),
      D1Bound5.IsD1Tuple t →
        t 0 = -1 →
          t 1 = 1 →
            (Monotone fun i => ‖phi ↑(t i)‖) →
              ∃ M,
                7 ≤ M.d ∧
                  M.d < 10000 ∧ M.d % 8 = 7 ∧ ∀ (i : Fin 4), D1Bound5.UnitPairRealDescription M.d (t ⟨↑i + 2, ⋯⟩)
