def D1Bound5.UnitPairRealDescription.{u_1} : {R : Type u_1} → [Ring R] → ℤ → R → Prop :=
fun {R} [Ring R] d z => ∃ u v, v ≠ 0 ∧ u ^ 2 - d * v ^ 2 = 2 ∧ (z = ↑(d * v ^ 2 + 1) ∨ z = -↑(d * v ^ 2 + 1))
structure D1Bound5.UnitPairArithmeticModel.{u_1} (R : Type u_1) [CommRing R] : Type u_1
number of parameters: 2
fields:
  D1Bound5.UnitPairArithmeticModel.d : ℤ
  D1Bound5.UnitPairArithmeticModel.positive : 0 < self.d
  D1Bound5.UnitPairArithmeticModel.squarefree : Squarefree self.d
  D1Bound5.UnitPairArithmeticModel.w : R
  D1Bound5.UnitPairArithmeticModel.square : self.w * self.w = -↑self.d
  D1Bound5.UnitPairArithmeticModel.conjugate : R →+* R
  D1Bound5.UnitPairArithmeticModel.conjugate_w : self.conjugate self.w = -self.w
  D1Bound5.UnitPairArithmeticModel.negative_square : ∀ m ≤ 0, (∃ r, r * r = ↑m) → ∃ y, m = -self.d * y ^ 2
  D1Bound5.UnitPairArithmeticModel.pell : ∀ (z r s : R),
      z ≠ 0 → r * r = z + 1 → s * s = 1 - z → D1Bound5.UnitPairPellDescription self.d self.w z
constructor:
  D1Bound5.UnitPairArithmeticModel.mk.{u_1} {R : Type u_1} [CommRing R] (d : ℤ) (positive : 0 < d)
    (squarefree : Squarefree d) (w : R) (square : w * w = -↑d) (conjugate : R →+* R) (conjugate_w : conjugate w = -w)
    (negative_square : ∀ m ≤ 0, (∃ r, r * r = ↑m) → ∃ y, m = -d * y ^ 2)
    (pell : ∀ (z r s : R), z ≠ 0 → r * r = z + 1 → s * s = 1 - z → D1Bound5.UnitPairPellDescription d w z) :
    D1Bound5.UnitPairArithmeticModel R
