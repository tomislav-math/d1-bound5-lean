@D1Bound5.lagrange_power_moment_remainder : ∀ {F : Type u_1} {ι : Type u_2} [inst : Field F] [inst_1 : DecidableEq ι]
  (s : Finset ι) (a : ι → F),
  Set.InjOn a ↑s →
    ∀ (n : ℕ), ∑ i ∈ s, a i ^ n / ∏ j ∈ s.erase i, (a i - a j) = (X ^ n %ₘ Lagrange.nodal s a).coeff (#s - 1)
'D1Bound5.lagrange_power_moment_remainder' depends on axioms: [propext, Classical.choice, Quot.sound]
