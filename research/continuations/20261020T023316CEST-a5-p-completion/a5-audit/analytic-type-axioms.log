    y ≠ 0 →
      x ≠ y →
        ∀ (j : Fin 3),
          D1Bound5.finiteUnequalClearedEntry x y c 5 4 1 j =
            4 * D1Bound5.finiteA5RowFactor x y 1 * D1Bound5.finiteA5Matrix x y c 1 j
@D1Bound5.finiteA5_residue_row2 : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (x y c : F),
  x ≠ 0 →
    y ≠ 0 →
      x ≠ y →
        ∀ (j : Fin 3),
          D1Bound5.finiteUnequalClearedEntry x y c 5 4 2 j =
            4 * D1Bound5.finiteA5RowFactor x y 2 * D1Bound5.finiteA5Matrix x y c 2 j
@D1Bound5.finiteA5_residue_identity : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (x y c : F),
  x ≠ 0 →
    y ≠ 0 →
      x ≠ y →
