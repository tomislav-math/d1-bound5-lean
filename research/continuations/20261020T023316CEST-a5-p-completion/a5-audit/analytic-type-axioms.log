D1Bound5.finiteA5Residual : ℂ → ℂ → ℂ → Fin 3 → ℂ
D1Bound5.finiteA5_beta : |Ring.choose (11 / 2) 14| = 495 / 33554432
D1Bound5.finiteA5_residual_sum_identity : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      x ≠ y →
        ∀ (i : Fin 3),
          4 * D1Bound5.finiteA5RowFactor x y i * D1Bound5.finiteA5Residual x y c i =
            ∑ j,
              D1Bound5.finiteUnequalClearedEntry x y c 5 4 i j *
                (1 + D1Bound5.bennettTwoNodes x y j * (x * y * c)⁻¹) ^ (1 / 2)
D1Bound5.finiteA5RowFactor_ne_zero : ∀ (x y : ℂ),
  x ≠ 0 → y ≠ 0 → x ≠ y → ∀ (i : Fin 3), D1Bound5.finiteA5RowFactor x y i ≠ 0
D1Bound5.finiteA5_residual_norm_lt_point : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        x ≠ y →
          ‖x‖ ≤ ‖y‖ →
            1000 ≤ ‖x‖ * ‖c‖ →
              ∀ (i : Fin 3),
                ‖D1Bound5.finiteA5Residual x y c i‖ <
                  101 / 100 * (495 / 33554432) * (4 ^ 5 * ‖x - y‖ ^ 10 / (‖x‖ ^ 5 * ‖y‖ ^ 5 * ‖c‖ ^ 9)) /
                    (4 * ‖D1Bound5.finiteA5RowFactor x y i‖)
D1Bound5.finiteA5_residual_norm_lt : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        x ≠ y →
          ‖x‖ ≤ ‖y‖ →
            1000 ≤ ‖x‖ * ‖c‖ →
              ∀ (i : Fin 3), ‖D1Bound5.finiteA5Residual x y c i‖ < 495 / 64 * ‖y‖ ^ 5 / (‖x‖ ^ 6 * ‖c‖ ^ 9)
D1Bound5.finiteA5Residual_explicit : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        ∀ (i : Fin 3),
          D1Bound5.finiteA5Residual x y c i =
            D1Bound5.finiteA5Constant x y c i + x * D1Bound5.finiteA5Left x y c i * (1 + 1 / (x * c)) ^ (1 / 2) +
              y * D1Bound5.finiteA5Right x y c i * (1 + 1 / (y * c)) ^ (1 / 2)
@D1Bound5.finiteA5RowForm_explicit : ∀ {R : Type u_1} [inst : CommRing R] (x y c z sX sY : R) (i : Fin 3),
  D1Bound5.finiteA5RowForm x y c z sX sY i =
    D1Bound5.finiteA5Constant x y c i * z + D1Bound5.finiteA5Left x y c i * sX + D1Bound5.finiteA5Right x y c i * sY
D1Bound5.finiteA5RowForm_norm_lt : ∀ (x y c z sX sY : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        z ≠ 0 →
          x ≠ y →
            ‖x‖ ≤ ‖y‖ →
              1000 ≤ ‖x‖ * ‖c‖ →
                ‖(1 + 1 / (x * c)) ^ (1 / 2) - sX / (x * z)‖ < 101 / 100 * ‖c‖ / (‖x‖ * ‖z‖ ^ 2) →
                  ‖(1 + 1 / (y * c)) ^ (1 / 2) - sY / (y * z)‖ < 101 / 100 * ‖c‖ / (‖y‖ * ‖z‖ ^ 2) →
                    ∀ (i : Fin 3),
                      ‖D1Bound5.finiteA5RowForm x y c z sX sY i‖ <
                        3113013 * ‖y‖ ^ 12 * ‖c‖ ^ 6 / ‖z‖ + 495 / 64 * ‖y‖ ^ 5 * ‖z‖ / (‖x‖ ^ 6 * ‖c‖ ^ 9)
@D1Bound5.full_ring_finiteA5_integer : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (x y c d rX rY vX vY z : 𝓞 K),
      x ≠ 0 →
        y ≠ 0 →
          c ≠ 0 →
            d ≠ 0 →
              x ≠ y →
                rX ^ 2 = x * c + 1 →
                  rY ^ 2 = y * c + 1 →
                    vX ^ 2 = x * d + 1 →
                      vY ^ 2 = y * d + 1 →
                        z ^ 2 = c * d + 1 →
                          ‖phi ↑x‖ ≤ ‖phi ↑y‖ →
                            1000 ≤ ‖phi ↑x‖ * ‖phi ↑c‖ →
                              200 * ‖phi ↑y‖ ≤ ‖phi ↑c‖ →
                                1 <
                                  3113013 * ‖phi ↑y‖ ^ 12 * ‖phi ↑c‖ ^ 6 / ‖phi ↑z‖ +
                                    495 / 64 * ‖phi ↑y‖ ^ 5 * ‖phi ↑z‖ / (‖phi ↑x‖ ^ 6 * ‖phi ↑c‖ ^ 9)
@D1Bound5.IsD1Tuple.finiteA5_inequality : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 4 → 𝓞 K),
      D1Bound5.IsD1Tuple t →
        ‖phi ↑(t 0)‖ ≤ ‖phi ↑(t 1)‖ →
          1000 ≤ ‖phi ↑(t 0)‖ * ‖phi ↑(t 2)‖ →
            200 * ‖phi ↑(t 1)‖ ≤ ‖phi ↑(t 2)‖ →
              ∃ z,
                z ^ 2 = t 2 * t 3 + 1 ∧
                  1 <
                    3113013 * ‖phi ↑(t 1)‖ ^ 12 * ‖phi ↑(t 2)‖ ^ 6 / ‖phi ↑z‖ +
                      495 / 64 * ‖phi ↑(t 1)‖ ^ 5 * ‖phi ↑z‖ / (‖phi ↑(t 0)‖ ^ 6 * ‖phi ↑(t 2)‖ ^ 9)
@D1Bound5.IsD1Tuple.finiteA5_closed_interval_excluded : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 4 → 𝓞 K),
      D1Bound5.IsD1Tuple t →
        ‖phi ↑(t 0)‖ ≤ ‖phi ↑(t 1)‖ →
          1000 ≤ ‖phi ↑(t 0)‖ * ‖phi ↑(t 2)‖ →
