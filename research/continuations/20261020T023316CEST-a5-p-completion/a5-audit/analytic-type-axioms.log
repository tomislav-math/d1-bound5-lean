D1Bound5.finiteA5_root_coefficient_norm_le : ∀ (x y : ℂ),
  ‖x‖ ≤ ‖y‖ →
    ∀ (i : Fin 3) (ell : Fin 6),
      ‖D1Bound5.finiteA5RootCoeff x y i 0 ell‖ + ‖D1Bound5.finiteA5RootCoeff x y i 1 ell‖ ≤
        ↑(D1Bound5.finiteA5CoefficientSums i ell) * ‖y‖ ^ (7 + ↑ell)
D1Bound5.finiteA5_coefficient_sums_nonneg : ∀ (i : Fin 3) (ell : Fin 6), 0 ≤ ↑(D1Bound5.finiteA5CoefficientSums i ell)
D1Bound5.finiteA5_height_slack : ∀ (i : Fin 3),
  101 / 100 * ∑ ell, ↑(D1Bound5.finiteA5CoefficientSums i ell) / 1000 ^ (5 - ↑ell) < 3113013
D1Bound5.finiteA5_root_columns_norm_le : ∀ (x y c : ℂ),
  ‖x‖ ≤ ‖y‖ →
    ∀ (i : Fin 3),
      ‖D1Bound5.finiteA5Left x y c i‖ + ‖D1Bound5.finiteA5Right x y c i‖ ≤
        ‖y‖ ^ 7 * ∑ ell, ↑(D1Bound5.finiteA5CoefficientSums i ell) * (‖y‖ * ‖c‖) ^ ↑ell
D1Bound5.finiteA5_height_scaled : ∀ (x y c : ℂ),
  y ≠ 0 →
    ‖x‖ ≤ ‖y‖ →
      1000 ≤ ‖y‖ * ‖c‖ →
        ∀ (i : Fin 3),
          101 / 100 * (‖D1Bound5.finiteA5Left x y c i‖ + ‖D1Bound5.finiteA5Right x y c i‖) <
            3113013 * ‖y‖ ^ 12 * ‖c‖ ^ 5
@D1Bound5.finiteA5_residue_row0 : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (x y c : F),
  x ≠ 0 →
    y ≠ 0 →
      x ≠ y →
        ∀ (j : Fin 3),
          D1Bound5.finiteUnequalClearedEntry x y c 5 4 0 j =
            4 * D1Bound5.finiteA5RowFactor x y 0 * D1Bound5.finiteA5Matrix x y c 0 j
@D1Bound5.finiteA5_residue_row1 : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (x y c : F),
