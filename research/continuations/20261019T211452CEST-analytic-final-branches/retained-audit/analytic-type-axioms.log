@D1Bound5.IsD1Tuple.all_large_retained_growth : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (a : Fin 5 → 𝓞 K),
      D1Bound5.IsD1Tuple a →
        (Monotone fun i => ‖phi ↑(a i)‖) →
          3 ≤ ‖phi ↑(a 0)‖ → 400 * (‖phi ↑(a 0)‖ ^ 7 * ‖phi ↑(a 1)‖ ^ 5 * ‖phi ↑(a 2)‖ ^ 3) < ‖phi ↑(a 4)‖
D1Bound5.retained_four_first_term_lt : ∀ (A B S T C D Z : ℝ),
  3 ≤ A →
    3 ≤ B →
      0 < S →
        0 < T →
          0 < Z →
            16 * B * S * T < C →
              A ^ 2 * C ^ 5 / S ^ 2 < D → 3999 / 4000 * C * D < Z ^ 2 → 13 * B * S ^ 2 * T ^ 3 / Z < 1 / 100
D1Bound5.retained_four_start_scalar_gap : ∀ (A B S T C D Z L : ℝ),
  3 ≤ A →
    3 ≤ B →
      0 < S →
        0 < T →
          S ≤ C →
            T ≤ C →
              1000 < C →
                0 < Z →
                  16 * B * S * T < C →
                    A ^ 2 * C ^ 5 / S ^ 2 < D →
                      3999 / 4000 * C * D < Z ^ 2 →
                        Z ^ 2 ≤ C * D + 1 →
                          1 ≤ L →
                            L < 13 * B * S ^ 2 * T ^ 3 / Z + 49 / 50 * S * T ^ 2 * Z / (A * C ^ 4) →
                              A ^ 2 * C ^ 7 / (S ^ 2 * T ^ 4) < D
D1Bound5.coherent_retained_h48_coefficient_gt_one : ∀ (A B R : ℝ),
  3 ≤ A → 3 ≤ B → 0 < R → R ≤ 8 → 1 < 9999 / 10000 * (200 / 19) ^ 2 * (1 / R - 51051 / 400000 / (A ^ 2 * B ^ 2)) ^ 2
@D1Bound5.full_ring_retained_three_basic_gap : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) {Tup : Finset (𝓞 K)},
      D1Bound5.IsD1 Tup →
        ∀ (a : Fin 5 → 𝓞 K),
          Function.Injective a →
            (∀ (i : Fin 5), a i ∈ Tup) →
              3 ≤ ‖phi ↑(a 0)‖ →
                ‖phi ↑(a 0)‖ ≤ ‖phi ↑(a 1)‖ →
                  ‖phi ↑(a 1)‖ ≤ ‖phi ↑(a 2)‖ →
                    2 * ‖phi ↑(a 0)‖ * ‖phi ↑(a 1)‖ * ‖phi ↑(a 2)‖ < ‖phi ↑(a 3)‖ →
                      3 * ‖phi ↑(a 0)‖ * ‖phi ↑(a 1)‖ * ‖phi ↑(a 2)‖ * ‖phi ↑(a 3)‖ < ‖phi ↑(a 4)‖ →
                        ‖phi ↑(a 0)‖ ^ 2 * ‖phi ↑(a 3)‖ ^ 5 / ‖phi ↑(a 2)‖ ^ 2 < ‖phi ↑(a 4)‖
@D1Bound5.IsD1Tuple.all_large_retained_power_gap : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
