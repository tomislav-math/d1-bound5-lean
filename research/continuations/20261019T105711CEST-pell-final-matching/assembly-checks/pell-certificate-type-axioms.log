D1Bound5.pellFieldCoverage_checked (k : Fin 1250) :
  have d := 7 + 8 * ↑↑k;
  have p := D1Bound5.pellExcludedFactors.getD (↑k) 0;
  d ∈ List.map Sigma.fst D1Bound5.pellCertifiedFields ∨ 2 ≤ p ∧ p * p ∣ d
