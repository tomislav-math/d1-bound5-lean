D1Bound5.pairLightSelectedFloorPrefixBool_add : ∀ (tau nu : Int) (sieve : List (ℕ × ℕ)) (m n : ℕ)
  (cached : List D1Bound5.PairLightCachedVertex) (rows : List (ℕ × List ℕ)),
  D1Bound5.pairLightSelectedFloorPrefixBool tau nu sieve (m + n) cached rows =
    (D1Bound5.pairLightSelectedFloorPrefixBool tau nu sieve m cached rows &&
      D1Bound5.pairLightSelectedFloorPrefixBool tau nu sieve n (List.drop m cached) (List.drop m rows))
