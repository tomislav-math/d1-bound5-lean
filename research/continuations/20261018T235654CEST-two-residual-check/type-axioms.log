    of_eq_true
      (Eq.trans
        (congrFun'
          (congrArg Eq
            (Eq.trans (norm_inv (a * b * c))
              (congrArg Inv.inv (Eq.trans (norm_mul (a * b) c) (congrFun' (congrArg HMul.hMul (norm_mul a b)) ‖c‖)))))
