+class FinalArtifactInventory:
+    """One stable artifact-tree snapshot for the drained final verification sweep.
+
+    Membership is indexed only; expected hashes still pass through Pins.verify.
+    A second complete metadata/membership snapshot must match before acceptance.
+    As with the build lock, this assumes coordinated, nonhostile filesystem writers.
+    """
+    def __init__(self, root):
+        self.root = Path(root)
+        self.metadata, self.names = self.capture()
+
+    @staticmethod
+    def metadata_of(path):
+        st = path.lstat()
+        check(not stat.S_ISLNK(st.st_mode), 'Symlink in final artifact inventory: ' + str(path))
+        check(stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode),
+              'Nonregular final artifact entry: ' + str(path))
+        return (st.st_dev, st.st_ino, st.st_mode, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
+
+    def capture(self):
+        metadata = {}; names = {}
+        def visit(directory):
+            before = self.metadata_of(directory)
+            check(stat.S_ISDIR(before[2]), 'Missing final artifact directory: ' + str(directory))
+            metadata[str(directory)] = before
+            with os.scandir(str(directory)) as entries:
+                paths = sorted((directory/entry.name for entry in entries), key=lambda p: p.name)
+            files = []
+            for path in paths:
+                row = self.metadata_of(path)
+                if stat.S_ISDIR(row[2]): visit(path)
+                else:
+                    metadata[str(path)] = row; files.append(path.name)
+            names[str(directory)] = tuple(files)
+            check(self.metadata_of(directory) == before,
+                  'Artifact directory changed during inventory: ' + str(directory))
+        visit(self.root)
+        # Catch a replacement in an already visited subtree before indexing is used.
+        for path, expected in metadata.items():
+            check(self.metadata_of(Path(path)) == expected,
+                  'Artifact entry changed during inventory: ' + path)
+        return metadata, names
+
+    def files(self, base):
+        base = Path(base)
+        names = self.names.get(str(base.parent), ())
+        found = set()
+        for prefix in [base.name, base.with_suffix('.ir').name]:
+            position = bisect_left(names, prefix)
+            while position < len(names) and names[position].startswith(prefix):
+                found.add(base.parent/names[position]); position += 1
+        return sorted(found)
+
+    def verify_unchanged(self):
+        current_metadata, current_names = self.capture()
+        check(current_metadata == self.metadata and current_names == self.names,
+              'Artifact tree changed during final verification sweep')
 
 
