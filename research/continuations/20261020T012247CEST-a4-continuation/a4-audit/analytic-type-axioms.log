@D1Bound5.finiteA4Constant : {R : Type u_1} → [CommRing R] → R → R → R → Fin 3 → R
@D1Bound5.finiteA4Left : {R : Type u_1} → [CommRing R] → R → R → R → Fin 3 → R
@D1Bound5.finiteA4Right : {R : Type u_1} → [CommRing R] → R → R → R → Fin 3 → R
@D1Bound5.finiteA4DividedMatrix : {R : Type u_1} → [CommRing R] → R → R → R → Matrix (Fin 3) (Fin 3) R
@D1Bound5.finiteA4Matrix : {R : Type u_1} → [CommRing R] → R → R → R → Matrix (Fin 3) (Fin 3) R
@D1Bound5.finiteA4RowFactor : {R : Type u_1} → [CommRing R] → R → R → Fin 3 → R
@D1Bound5.finiteA4Matrix_zero : ∀ {R : Type u_1} [inst : CommRing R] (x y c : R) (i : Fin 3),
  D1Bound5.finiteA4Matrix x y c i 0 = D1Bound5.finiteA4Constant x y c i
@D1Bound5.finiteA4Matrix_one : ∀ {R : Type u_1} [inst : CommRing R] (x y c : R) (i : Fin 3),
  D1Bound5.finiteA4Matrix x y c i 1 = x * D1Bound5.finiteA4Left x y c i
@D1Bound5.finiteA4Matrix_two : ∀ {R : Type u_1} [inst : CommRing R] (x y c : R) (i : Fin 3),
  D1Bound5.finiteA4Matrix x y c i 2 = y * D1Bound5.finiteA4Right x y c i
@D1Bound5.finiteA4DividedMatrix_det : ∀ {R : Type u_1} [inst : CommRing R] (x y c : R),
  (D1Bound5.finiteA4DividedMatrix x y c).det = 2910600 * (x * y) ^ 1 * c ^ 1 * (x - y) ^ 15
@D1Bound5.finiteA4Matrix_det : ∀ {R : Type u_1} [inst : CommRing R] (x y c : R),
  (D1Bound5.finiteA4Matrix x y c).det = 2910600 * (x * y) ^ 2 * c ^ 1 * (x - y) ^ 15
@D1Bound5.finiteA4DividedMatrix_det_ne_zero : ∀ {F : Type u_1} [inst : Field F] [CharZero F] (x y c : F),
  x ≠ 0 → y ≠ 0 → c ≠ 0 → x ≠ y → (D1Bound5.finiteA4DividedMatrix x y c).det ≠ 0
D1Bound5.finiteA4Coeff0 : Fin 3 → Fin 2 → Fin 6 → ℤ
D1Bound5.finiteA4Coeff1 : Fin 3 → Fin 2 → Fin 7 → ℤ
D1Bound5.finiteA4Coeff2 : Fin 3 → Fin 2 → Fin 8 → ℤ
D1Bound5.finiteA4Coeff3 : Fin 3 → Fin 2 → Fin 9 → ℤ
D1Bound5.finiteA4Coeff4 : Fin 3 → Fin 2 → Fin 10 → ℤ
@D1Bound5.finiteA4RootCoeff : {R : Type u_1} → [CommRing R] → R → R → Fin 3 → Fin 2 → Fin 5 → R
@D1Bound5.finiteA4_root_coeff_decomposition : ∀ {R : Type u_1} [inst : CommRing R] (x y c : R) (i : Fin 3) (j : Fin 2),
  ![D1Bound5.finiteA4Left x y c i, D1Bound5.finiteA4Right x y c i] j =
    ∑ ell, D1Bound5.finiteA4RootCoeff x y i j ell * c ^ ↑ell
D1Bound5.finiteA4CoefficientSums : Fin 3 → Fin 5 → ℤ
D1Bound5.finiteA4_coefficient_sums_0 : ∀ (i : Fin 3),
  ∑ r, |↑(D1Bound5.finiteA4Coeff0 i 0 r)| + ∑ r, |↑(D1Bound5.finiteA4Coeff0 i 1 r)| =
    ↑(D1Bound5.finiteA4CoefficientSums i 0)
D1Bound5.finiteA4_coefficient_sums_1 : ∀ (i : Fin 3),
  ∑ r, |↑(D1Bound5.finiteA4Coeff1 i 0 r)| + ∑ r, |↑(D1Bound5.finiteA4Coeff1 i 1 r)| =
    ↑(D1Bound5.finiteA4CoefficientSums i 1)
D1Bound5.finiteA4_coefficient_sums_2 : ∀ (i : Fin 3),
  ∑ r, |↑(D1Bound5.finiteA4Coeff2 i 0 r)| + ∑ r, |↑(D1Bound5.finiteA4Coeff2 i 1 r)| =
    ↑(D1Bound5.finiteA4CoefficientSums i 2)
D1Bound5.finiteA4_coefficient_sums_3 : ∀ (i : Fin 3),
  ∑ r, |↑(D1Bound5.finiteA4Coeff3 i 0 r)| + ∑ r, |↑(D1Bound5.finiteA4Coeff3 i 1 r)| =
    ↑(D1Bound5.finiteA4CoefficientSums i 3)
D1Bound5.finiteA4_coefficient_sums_4 : ∀ (i : Fin 3),
  ∑ r, |↑(D1Bound5.finiteA4Coeff4 i 0 r)| + ∑ r, |↑(D1Bound5.finiteA4Coeff4 i 1 r)| =
    ↑(D1Bound5.finiteA4CoefficientSums i 4)
@D1Bound5.map_finiteA4Constant : ∀ {R : Type u_1} {S : Type u_2} [inst : CommRing R] [inst_1 : CommRing S] (f : R →+* S)
  (x y c : R) (i : Fin 3), f (D1Bound5.finiteA4Constant x y c i) = D1Bound5.finiteA4Constant (f x) (f y) (f c) i
@D1Bound5.map_finiteA4Left : ∀ {R : Type u_1} {S : Type u_2} [inst : CommRing R] [inst_1 : CommRing S] (f : R →+* S)
  (x y c : R) (i : Fin 3), f (D1Bound5.finiteA4Left x y c i) = D1Bound5.finiteA4Left (f x) (f y) (f c) i
@D1Bound5.map_finiteA4Right : ∀ {R : Type u_1} {S : Type u_2} [inst : CommRing R] [inst_1 : CommRing S] (f : R →+* S)
  (x y c : R) (i : Fin 3), f (D1Bound5.finiteA4Right x y c i) = D1Bound5.finiteA4Right (f x) (f y) (f c) i
@D1Bound5.map_finiteA4DividedMatrix : ∀ {R : Type u_1} {S : Type u_2} [inst : CommRing R] [inst_1 : CommRing S]
  (f : R →+* S) (x y c : R) (i j : Fin 3),
  f (D1Bound5.finiteA4DividedMatrix x y c i j) = D1Bound5.finiteA4DividedMatrix (f x) (f y) (f c) i j
@D1Bound5.finiteA4RowForm : {R : Type u_1} → [CommRing R] → R → R → R → R → R → R → Fin 3 → R
@D1Bound5.map_finiteA4RowForm : ∀ {R : Type u_1} {S : Type u_2} [inst : CommRing R] [inst_1 : CommRing S] (f : R →+* S)
  (x y c z sX sY : R) (i : Fin 3),
  f (D1Bound5.finiteA4RowForm x y c z sX sY i) = D1Bound5.finiteA4RowForm (f x) (f y) (f c) (f z) (f sX) (f sY) i
@D1Bound5.finiteA4RowForm_exists_ne_zero : ∀ {F : Type u_1} [inst : Field F] [CharZero F] (x y c z sX sY : F),
  x ≠ 0 → y ≠ 0 → c ≠ 0 → x ≠ y → z ≠ 0 → ∃ i, D1Bound5.finiteA4RowForm x y c z sX sY i ≠ 0
@D1Bound5.full_ring_finiteA4RowForm_exists_one_le_norm : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (x y c z sX sY : 𝓞 K),
      x ≠ 0 →
        y ≠ 0 →
          c ≠ 0 →
            x ≠ y →
              z ≠ 0 → ∃ i, 1 ≤ ‖D1Bound5.finiteA4RowForm (phi ↑x) (phi ↑y) (phi ↑c) (phi ↑z) (phi ↑sX) (phi ↑sY) i‖
D1Bound5.finiteA4_root_coefficient_norm_le : ∀ (x y : ℂ),
  ‖x‖ ≤ ‖y‖ →
    ∀ (i : Fin 3) (ell : Fin 5),
      ‖D1Bound5.finiteA4RootCoeff x y i 0 ell‖ + ‖D1Bound5.finiteA4RootCoeff x y i 1 ell‖ ≤
        ↑(D1Bound5.finiteA4CoefficientSums i ell) * ‖y‖ ^ (5 + ↑ell)
D1Bound5.finiteA4_coefficient_sums_nonneg : ∀ (i : Fin 3) (ell : Fin 5), 0 ≤ ↑(D1Bound5.finiteA4CoefficientSums i ell)
D1Bound5.finiteA4_height_slack : ∀ (i : Fin 3),
  101 / 100 * ∑ ell, ↑(D1Bound5.finiteA4CoefficientSums i ell) / 1000 ^ (4 - ↑ell) < 165763
D1Bound5.finiteA4_root_columns_norm_le : ∀ (x y c : ℂ),
  ‖x‖ ≤ ‖y‖ →
    ∀ (i : Fin 3),
      ‖D1Bound5.finiteA4Left x y c i‖ + ‖D1Bound5.finiteA4Right x y c i‖ ≤
        ‖y‖ ^ 5 * ∑ ell, ↑(D1Bound5.finiteA4CoefficientSums i ell) * (‖y‖ * ‖c‖) ^ ↑ell
D1Bound5.finiteA4_height_scaled : ∀ (x y c : ℂ),
  y ≠ 0 →
    ‖x‖ ≤ ‖y‖ →
      1000 ≤ ‖y‖ * ‖c‖ →
        ∀ (i : Fin 3),
          101 / 100 * (‖D1Bound5.finiteA4Left x y c i‖ + ‖D1Bound5.finiteA4Right x y c i‖) < 165763 * ‖y‖ ^ 9 * ‖c‖ ^ 4
@D1Bound5.finiteA4_residue_identity : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (x y c : F),
  x ≠ 0 →
    y ≠ 0 →
      x ≠ y →
        ∀ (i j : Fin 3),
          D1Bound5.finiteUnequalClearedEntry x y c 4 3 i j =
            2 * D1Bound5.finiteA4RowFactor x y i * D1Bound5.finiteA4Matrix x y c i j
D1Bound5.finiteA4Residual : ℂ → ℂ → ℂ → Fin 3 → ℂ
D1Bound5.finiteA4_beta : |Ring.choose (9 / 2) 11| = 63 / 524288
D1Bound5.finiteA4_residual_sum_identity : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      x ≠ y →
        ∀ (i : Fin 3),
          2 * D1Bound5.finiteA4RowFactor x y i * D1Bound5.finiteA4Residual x y c i =
            ∑ j,
              D1Bound5.finiteUnequalClearedEntry x y c 4 3 i j *
                (1 + D1Bound5.bennettTwoNodes x y j * (x * y * c)⁻¹) ^ (1 / 2)
D1Bound5.finiteA4RowFactor_ne_zero : ∀ (x y : ℂ),
  x ≠ 0 → y ≠ 0 → x ≠ y → ∀ (i : Fin 3), D1Bound5.finiteA4RowFactor x y i ≠ 0
D1Bound5.finiteA4_residual_norm_lt_point : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        x ≠ y →
          ‖x‖ ≤ ‖y‖ →
            1000 ≤ ‖x‖ * ‖c‖ →
              ∀ (i : Fin 3),
                ‖D1Bound5.finiteA4Residual x y c i‖ <
                  101 / 100 * (63 / 524288) * (4 ^ 4 * ‖x - y‖ ^ 8 / (‖x‖ ^ 4 * ‖y‖ ^ 4 * ‖c‖ ^ 7)) /
                    (2 * ‖D1Bound5.finiteA4RowFactor x y i‖)
D1Bound5.finiteA4_residual_norm_lt : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        x ≠ y →
          ‖x‖ ≤ ‖y‖ →
            1000 ≤ ‖x‖ * ‖c‖ →
              ∀ (i : Fin 3), ‖D1Bound5.finiteA4Residual x y c i‖ < 63 / 8 * ‖y‖ ^ 4 / (‖x‖ ^ 5 * ‖c‖ ^ 7)
D1Bound5.finiteA4Residual_explicit : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        ∀ (i : Fin 3),
          D1Bound5.finiteA4Residual x y c i =
            D1Bound5.finiteA4Constant x y c i + x * D1Bound5.finiteA4Left x y c i * (1 + 1 / (x * c)) ^ (1 / 2) +
              y * D1Bound5.finiteA4Right x y c i * (1 + 1 / (y * c)) ^ (1 / 2)
@D1Bound5.finiteA4RowForm_explicit : ∀ {R : Type u_1} [inst : CommRing R] (x y c z sX sY : R) (i : Fin 3),
  D1Bound5.finiteA4RowForm x y c z sX sY i =
    D1Bound5.finiteA4Constant x y c i * z + D1Bound5.finiteA4Left x y c i * sX + D1Bound5.finiteA4Right x y c i * sY
D1Bound5.finiteA4RowForm_norm_lt : ∀ (x y c z sX sY : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        z ≠ 0 →
          x ≠ y →
            ‖x‖ ≤ ‖y‖ →
              1000 ≤ ‖x‖ * ‖c‖ →
                ‖(1 + 1 / (x * c)) ^ (1 / 2) - sX / (x * z)‖ < 101 / 100 * ‖c‖ / (‖x‖ * ‖z‖ ^ 2) →
                  ‖(1 + 1 / (y * c)) ^ (1 / 2) - sY / (y * z)‖ < 101 / 100 * ‖c‖ / (‖y‖ * ‖z‖ ^ 2) →
                    ∀ (i : Fin 3),
                      ‖D1Bound5.finiteA4RowForm x y c z sX sY i‖ <
                        165763 * ‖y‖ ^ 9 * ‖c‖ ^ 5 / ‖z‖ + 63 / 8 * ‖y‖ ^ 4 * ‖z‖ / (‖x‖ ^ 5 * ‖c‖ ^ 7)
@D1Bound5.full_ring_finiteA4_integer : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (x y c d rX rY vX vY z : 𝓞 K),
      x ≠ 0 →
        y ≠ 0 →
          c ≠ 0 →
            d ≠ 0 →
              x ≠ y →
                rX ^ 2 = x * c + 1 →
                  rY ^ 2 = y * c + 1 →
                    vX ^ 2 = x * d + 1 →
                      vY ^ 2 = y * d + 1 →
                        z ^ 2 = c * d + 1 →
                          ‖phi ↑x‖ ≤ ‖phi ↑y‖ →
                            1000 ≤ ‖phi ↑x‖ * ‖phi ↑c‖ →
                              200 * ‖phi ↑y‖ ≤ ‖phi ↑c‖ →
                                1 <
                                  165763 * ‖phi ↑y‖ ^ 9 * ‖phi ↑c‖ ^ 5 / ‖phi ↑z‖ +
                                    63 / 8 * ‖phi ↑y‖ ^ 4 * ‖phi ↑z‖ / (‖phi ↑x‖ ^ 5 * ‖phi ↑c‖ ^ 7)
@D1Bound5.IsD1Tuple.finiteA4_inequality : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 4 → 𝓞 K),
      D1Bound5.IsD1Tuple t →
        ‖phi ↑(t 0)‖ ≤ ‖phi ↑(t 1)‖ →
          1000 ≤ ‖phi ↑(t 0)‖ * ‖phi ↑(t 2)‖ →
            200 * ‖phi ↑(t 1)‖ ≤ ‖phi ↑(t 2)‖ →
              ∃ z,
                z ^ 2 = t 2 * t 3 + 1 ∧
                  1 <
                    165763 * ‖phi ↑(t 1)‖ ^ 9 * ‖phi ↑(t 2)‖ ^ 5 / ‖phi ↑z‖ +
                      63 / 8 * ‖phi ↑(t 1)‖ ^ 4 * ‖phi ↑z‖ / (‖phi ↑(t 0)‖ ^ 5 * ‖phi ↑(t 2)‖ ^ 7)
@D1Bound5.IsD1Tuple.finiteA4_closed_interval_excluded : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 4 → 𝓞 K),
      D1Bound5.IsD1Tuple t →
        ‖phi ↑(t 0)‖ ≤ ‖phi ↑(t 1)‖ →
          1000 ≤ ‖phi ↑(t 0)‖ * ‖phi ↑(t 2)‖ →
            200 * ‖phi ↑(t 1)‖ ≤ ‖phi ↑(t 2)‖ →
              ‖phi ↑(t 2)‖ ≤ ‖phi ↑(t 3)‖ →
                4 * 165763 ^ 2 * ‖phi ↑(t 1)‖ ^ 18 * ‖phi ↑(t 2)‖ ^ 9 / (1 - 1 / 4000) ≤ ‖phi ↑(t 3)‖ →
                  ‖phi ↑(t 3)‖ ≤
                      16 * ‖phi ↑(t 0)‖ ^ 10 * ‖phi ↑(t 2)‖ ^ 13 / (3969 * ‖phi ↑(t 1)‖ ^ 8 * (1 + 1 / 4000)) →
                    False
