RATIONAL_FIRST_AXIOMS_PASS D1Bound5.IsD1Tuple.rational_first_pair_third_eq_eight: [propext,
 Classical.choice,
 Quot.sound]
@D1Bound5.IsD1Tuple.rational_first_pair_third_eq_eight : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (a : Fin 6 → 𝓞 K),
      D1Bound5.IsD1Tuple a →
        (Monotone fun i => ‖phi ↑(a i)‖) →
          ∀ (sgn : Bool),
            (a 0 = if sgn = true then -1 else 1) →
              (a 1 = if sgn = true then -3 else 3) → a 2 = if sgn = true then -8 else 8
