@D1Bound5.IsD1Tuple.one_small_first_triple_classification : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 3 → NumberField.RingOfIntegers K),
      D1Bound5.IsD1Tuple t →
        ‖phi ↑(t 0)‖ ^ 2 = 1 ∧ 9 ≤ ‖phi ↑(t 1)‖ ^ 2 ∧ ‖phi ↑(t 1)‖ ^ 2 < 64 ∨
            ‖phi ↑(t 0)‖ ^ 2 = 2 ∧ 9 ≤ ‖phi ↑(t 1)‖ ^ 2 ∧ ‖phi ↑(t 1)‖ ^ 2 < 16 →
          ‖phi ↑(t 2)‖ ^ 2 < 225 →
            ‖phi ↑(t 1)‖ ^ 2 ≤ ‖phi ↑(t 2)‖ ^ 2 →
              t 0 = 1 ∧ t 1 = 3 ∨
                t 0 = -1 ∧ t 1 = -3 ∨
                  ∃ tau nu e,
                    (tau, nu) ∈ D1Bound5.smallPairModels ∧
                      D1Bound5.OneSmallNormalizedThirdRows (e.symm (t 0)) (e.symm (t 1)) (e.symm (t 2))
@D1Bound5.oneSmallRowMembership_full_ring_bound : ∀ {K : Type u_1} [inst : Field K] [NumberField K]
  [NumberField.IsTotallyComplex K] {tau nu : ℤ} (e : D1Bound5.QuadInt tau nu ≃+* NumberField.RingOfIntegers K)
  (phi : K →+* ℂ) (sgn conj : Bool) (a b s z : NumberField.RingOfIntegers K) (cutoff : ℤ),
  D1Bound5.OneSmallRowMembership (D1Bound5.smallExtensionSymmetry sgn conj (e.symm a))
      (D1Bound5.smallExtensionSymmetry sgn conj (e.symm b)) (D1Bound5.smallExtensionSymmetry sgn conj (e.symm s))
      cutoff →
    ‖phi ↑z‖ ^ 2 < ↑cutoff →
      (∃ q, q * q = a * z + 1) →
        (∃ q, q * q = b * z + 1) → (∃ q, q * q = s * z + 1) → ‖phi ↑z‖ ^ 2 ≤ 4 * ‖phi ↑b‖ ^ 2 * ‖phi ↑s‖ ^ 2
@D1Bound5.oneSmallRowMembership_full_ring_excludes_irregular_bound : ∀ {K : Type u_1} [inst : Field K] [NumberField K]
  [NumberField.IsTotallyComplex K] {tau nu : ℤ} (e : D1Bound5.QuadInt tau nu ≃+* NumberField.RingOfIntegers K)
  (phi : K →+* ℂ) (sgn conj : Bool) (a b s z : NumberField.RingOfIntegers K) (cutoff : ℤ),
  D1Bound5.OneSmallRowMembership (D1Bound5.smallExtensionSymmetry sgn conj (e.symm a))
      (D1Bound5.smallExtensionSymmetry sgn conj (e.symm b)) (D1Bound5.smallExtensionSymmetry sgn conj (e.symm s))
      cutoff →
    ‖phi ↑z‖ ^ 2 < ↑cutoff →
      (∃ q, q * q = a * z + 1) →
        (∃ q, q * q = b * z + 1) → (∃ q, q * q = s * z + 1) → 4 * ‖phi ↑b‖ ^ 2 * ‖phi ↑s‖ ^ 2 < ‖phi ↑z‖ ^ 2 → False
