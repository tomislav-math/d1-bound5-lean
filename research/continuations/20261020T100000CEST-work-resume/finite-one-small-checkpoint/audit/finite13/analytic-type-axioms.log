  D1Bound5.firstPairCoordinates a b = D1Bound5.firstPairCoordinates a' b' → a = a' ∧ b = b'
@D1Bound5.firstPairOrbit_normalize : ∀ {tau nu : ℤ} (a b : D1Bound5.QuadInt tau nu) (row : (ℤ × ℤ) × ℤ × ℤ),
  D1Bound5.firstPairCoordinates a b ∈ D1Bound5.firstPairOrbit tau row →
    ∃ sgn conj,
      D1Bound5.smallExtensionSymmetry sgn conj a = D1Bound5.firstPairRowA tau nu row ∧
        D1Bound5.smallExtensionSymmetry sgn conj b = D1Bound5.firstPairRowB tau nu row
