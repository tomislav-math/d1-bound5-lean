D1Bound5.oneSmallFixedRows_metadata : ∀ r ∈ D1Bound5.oneSmallFixedRows,
  1024 ≤ r.cutoff ∧
    (QuadraticAlgebra.norm r.anchorA = 1 ∨ QuadraticAlgebra.norm r.anchorA = 2) ∧
      9 ≤ QuadraticAlgebra.norm r.anchorB ∧
        (QuadraticAlgebra.norm r.anchorA = 2 →
          4 * QuadraticAlgebra.norm r.anchorA * QuadraticAlgebra.norm r.anchorB * QuadraticAlgebra.norm r.anchorS <
            r.cutoff)
