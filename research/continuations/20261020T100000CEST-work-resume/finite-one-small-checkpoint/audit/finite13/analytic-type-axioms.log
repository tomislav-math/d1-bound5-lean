@D1Bound5.oneSmallThirdRows_of_table_orbits : ∀ {tau nu : ℤ} (table : List ((ℤ × ℤ) × ℤ × ℤ))
  (reps : Finset ((ℤ × ℤ) × ℤ × ℤ)),
  table.toFinset = reps.biUnion (D1Bound5.firstPairOrbit tau) →
    (∀ row ∈ reps,
        D1Bound5.OneSmallThirdRowProperty (D1Bound5.firstPairRowA tau nu row) (D1Bound5.firstPairRowB tau nu row)) →
      ∀ (a b s : D1Bound5.QuadInt tau nu),
        D1Bound5.firstPairCoordinates a b ∈ table →
          QuadraticAlgebra.norm s ≤ 224 →
            QuadraticAlgebra.norm b ≤ QuadraticAlgebra.norm s →
              s ≠ a → s ≠ b → D1Bound5.PairExtension a b s → D1Bound5.OneSmallNormalizedThirdRows a b s
