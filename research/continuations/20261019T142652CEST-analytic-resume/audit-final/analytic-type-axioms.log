D1Bound5.bennett_two_rate_scalar_lower : ∀ (T : ℝ), 1000 ≤ T → 128 * T ^ 2 < 135 * (T - 1) ^ 2
D1Bound5.bennettTwoResidualRate_lower : ∀ (A B C δ : ℝ),
  0 < A →
    0 < B → 0 < δ → A ≤ B → δ ≤ A + B → 1000 ≤ A * C → 2 * A * C ^ 2 / (5 * B) < D1Bound5.bennettTwoResidualRate A B C δ
D1Bound5.bennettTwoResidualRate_norm_lower : ∀ (a b c : ℂ),
  a ≠ 0 →
    b ≠ 0 →
      a ≠ b →
        ‖a‖ ≤ ‖b‖ →
          1000 ≤ ‖a‖ * ‖c‖ → 2 * ‖a‖ * ‖c‖ ^ 2 / (5 * ‖b‖) < D1Bound5.bennettTwoResidualRate ‖a‖ ‖b‖ ‖c‖ ‖a - b‖
D1Bound5.coherent_three_parameter_1000 : 0 < D1Bound5.coherentThreeLowerConstant 1000 ∧
  0 < D1Bound5.coherentThreeUpperConstant 1000 ∧
    100 * D1Bound5.coherentThreeUpperConstant 1000 / 99 < 3 / 32 ∧
      5 < 100 / (201 * D1Bound5.coherentThreeUpperConstant 1000) ∧
        100 / (199 * D1Bound5.coherentThreeLowerConstant 1000) < 15
D1Bound5.coherent_three_separated_bounds : ∀ (a : Fin 3 → ℂ) (p q eta : ℂ),
  Function.Injective a →
    0 < ‖a 0‖ →
      ‖a 0‖ ≤ ‖a 1‖ →
        ‖a 1‖ ≤ ‖a 2‖ →
          0 < ‖p‖ →
            1000 ≤ ‖a 0‖ * ‖p‖ →
              4 * ‖p‖ ≤ ‖q‖ →
                10000 < ‖p‖ * ‖q‖ →
                  eta ^ 2 = p * q →
                    ‖D1Bound5.coherentQuotientForm a (D1Bound5.coherentVandermonde3 a) p q eta‖ <
                        5 * ‖a 1‖ * ‖a 2‖ ^ 2 / ‖D1Bound5.coherentTerminalRoot p q eta‖ +
                          3 * ‖a 2‖ * ‖D1Bound5.coherentTerminalRoot p q eta‖ / (4 * ‖a 0‖ * ‖p‖ ^ 3) ∧
                      (D1Bound5.coherentQuotientForm a (D1Bound5.coherentVandermonde3 a) p q eta = 0 →
                        5 * ‖a 0‖ * ‖a 1‖ * ‖a 2‖ * ‖p‖ ^ 2 < ‖q‖ ∧ ‖q‖ < 15 * ‖a 0‖ * ‖a 1‖ * ‖a 2‖ * ‖p‖ ^ 2)
D1Bound5.finite_eta_power_lower : ∀ (T e : ℝ), 1000 ≤ T → e ≤ 9 → 100 / 101 < (1 - 1 / T) ^ e
D1Bound5.finite_eta_reciprocal_lt : ∀ (T e : ℝ), 1000 ≤ T → e ≤ 9 → 1 / (1 - 1 / T) ^ e < 101 / 100
@D1Bound5.finiteMNodes : {F : Type u_1} → [Field F] → F → F → F → Fin 4 → F
@D1Bound5.finiteMBennettEntry : {F : Type u_1} → [inst : Field F] → [CharZero F] → F → F → F → F → Fin 4 → Fin 4 → F
@D1Bound5.finiteM_bennett_identity : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (a b s c : F),
  a ≠ 0 →
    b ≠ 0 →
      s ≠ 0 →
        a ≠ b →
          a ≠ s →
            b ≠ s →
              ∀ (i j : Fin 4),
                D1Bound5.finiteMBennettEntry a b s c i j =
                  D1Bound5.finiteMRowFactor a b s i * D1Bound5.finiteMMatrix a b s c i j
@D1Bound5.finiteMNodes_injective : ∀ {F : Type u_1} [inst : Field F] [CharZero F] (a b s : F),
  a ≠ 0 → b ≠ 0 → s ≠ 0 → a ≠ b → a ≠ s → b ≠ s → Function.Injective (D1Bound5.finiteMNodes a b s)
@D1Bound5.finiteMDividedMatrix_det_ne_zero : ∀ {F : Type u_1} [inst : Field F] [CharZero F] (a b s c : F),
  a ≠ 0 → b ≠ 0 → s ≠ 0 → a ≠ b → a ≠ s → b ≠ s → (D1Bound5.finiteMDividedMatrix a b s c).det ≠ 0
@D1Bound5.full_ring_finiteM_inequality : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) {S : Finset (NumberField.RingOfIntegers K)},
      D1Bound5.IsD1 S →
        ∀ (a : Fin 3 → NumberField.RingOfIntegers K) (c d : NumberField.RingOfIntegers K),
          (∀ (j : Fin 3), a j ∈ S) →
            c ∈ S →
              d ∈ S →
                Function.Injective a →
                  (∀ (j : Fin 3), a j ≠ c) →
                    (∀ (j : Fin 3), a j ≠ d) →
                      c ≠ d →
                        (Monotone fun j => ‖phi ↑(a j)‖) →
                          4 * ‖phi ↑(a 2)‖ ≤ ‖phi ↑c‖ →
                            ‖phi ↑c‖ ≤ ‖phi ↑d‖ →
                              1000 ≤ ‖phi ↑(a 0)‖ * ‖phi ↑c‖ →
                                ∃ z,
                                  z ^ 2 = c * d + 1 ∧
                                    1 <
                                      8 / 9 * 608 ^ 2 * ‖phi ↑(a 1)‖ ^ 3 * ‖phi ↑(a 2)‖ ^ 8 * ‖phi ↑c‖ ^ 3 / ‖phi ↑z‖ +
                                        3920 / 81 * ‖phi ↑(a 1)‖ ^ 2 * ‖phi ↑(a 2)‖ ^ 5 * ‖phi ↑z‖ /
                                          (‖phi ↑(a 0)‖ ^ 3 * ‖phi ↑c‖ ^ 6)
D1Bound5.finiteMTermEval_norm_le : ∀ (t : D1Bound5.FiniteMTerm) (a b s v : ℂ) (B S C : ℝ),
  1 ≤ B →
    B ≤ S →
      1 ≤ C →
        ‖a‖ ≤ B →
          ‖b‖ ≤ B →
            ‖s‖ ≤ S →
              ‖v‖ ≤ 2 * S * C →
                D1Bound5.finiteMTermAdmissible t →
                  ‖D1Bound5.finiteMTermEval t a b s v‖ ≤ ↑(D1Bound5.finiteMTermWeight t) * B ^ 3 * S ^ 8 * C ^ 2
D1Bound5.finiteMDividedMatrix_root_height : ∀ (a b s c : ℂ),
  1 ≤ ‖b‖ →
    ‖a‖ ≤ ‖b‖ →
      ‖b‖ ≤ ‖s‖ →
        1 ≤ ‖c‖ →
          ∀ (i : Fin 4), ∑ j, ‖D1Bound5.finiteMDividedMatrix a b s c i j.succ‖ ≤ 169728 * ‖b‖ ^ 3 * ‖s‖ ^ 8 * ‖c‖ ^ 2
@D1Bound5.finiteMRowForm : {R : Type u_1} → [CommRing R] → R → R → R → R → R → R → R → R → Fin 4 → R
@D1Bound5.map_finiteMRowForm : ∀ {R : Type u_1} {S : Type u_2} [inst : CommRing R] [inst_1 : CommRing S] (f : R →+* S)
  (a b s c z rA rB rS : R) (i : Fin 4),
  f (D1Bound5.finiteMRowForm a b s c z rA rB rS i) =
    D1Bound5.finiteMRowForm (f a) (f b) (f s) (f c) (f z) (f rA) (f rB) (f rS) i
@D1Bound5.finiteMRowForm_exists_ne_zero : ∀ {F : Type u_1} [inst : Field F] [CharZero F] (a b s c z rA rB rS : F),
  a ≠ 0 → b ≠ 0 → s ≠ 0 → a ≠ b → a ≠ s → b ≠ s → z ≠ 0 → ∃ i, D1Bound5.finiteMRowForm a b s c z rA rB rS i ≠ 0
@D1Bound5.full_ring_finiteMRowForm_exists_one_le_norm : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (a b s c z rA rB rS : NumberField.RingOfIntegers K),
      a ≠ 0 →
        b ≠ 0 →
          s ≠ 0 →
            a ≠ b →
              a ≠ s →
                b ≠ s →
                  z ≠ 0 →
                    ∃ i,
                      1 ≤
                        ‖D1Bound5.finiteMRowForm (phi ↑a) (phi ↑b) (phi ↑s) (phi ↑c) (phi ↑z) (phi ↑rA) (phi ↑rB)
                            (phi ↑rS) i‖
@D1Bound5.full_ring_finiteM_closed_interval_excluded : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) {S : Finset (NumberField.RingOfIntegers K)},
      D1Bound5.IsD1 S →
        ∀ (a : Fin 3 → NumberField.RingOfIntegers K) (c d : NumberField.RingOfIntegers K),
          (∀ (j : Fin 3), a j ∈ S) →
            c ∈ S →
              d ∈ S →
                Function.Injective a →
                  (∀ (j : Fin 3), a j ≠ c) →
                    (∀ (j : Fin 3), a j ≠ d) →
                      c ≠ d →
                        (Monotone fun j => ‖phi ↑(a j)‖) →
                          4 * ‖phi ↑(a 2)‖ ≤ ‖phi ↑c‖ →
                            ‖phi ↑c‖ ≤ ‖phi ↑d‖ →
                              1000 ≤ ‖phi ↑(a 0)‖ * ‖phi ↑c‖ →
                                4 * (8 / 9 * 608 ^ 2) ^ 2 * ‖phi ↑(a 1)‖ ^ 6 * ‖phi ↑(a 2)‖ ^ 16 * ‖phi ↑c‖ ^ 5 /
                                      (1 - 1 / 4000) ≤
                                    ‖phi ↑d‖ →
                                  ‖phi ↑d‖ ≤
                                      ‖phi ↑(a 0)‖ ^ 6 * ‖phi ↑c‖ ^ 11 /
                                        (4 * (3920 / 81) ^ 2 * ‖phi ↑(a 1)‖ ^ 4 * ‖phi ↑(a 2)‖ ^ 10 * (1 + 1 / 4000)) →
                                    False
