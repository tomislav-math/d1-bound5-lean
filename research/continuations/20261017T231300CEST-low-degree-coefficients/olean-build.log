D1Bound5.lowDegreeHalfCoefficient_two : ∀ (x y : ℂ), D1Bound5.lowDegreeHalfCoefficient x y 2 = -(x - y) ^ 2 / 8
D1Bound5.lowDegreeHalfCoefficient_three : ∀ (x y : ℂ),
  D1Bound5.lowDegreeHalfCoefficient x y 3 = (x ^ 2 - y ^ 2) * (x - y) / 16
D1Bound5.lowDegreeHalfCoefficient_four : ∀ (x y : ℂ),
  D1Bound5.lowDegreeHalfCoefficient x y 4 = -(x - y) ^ 2 * (5 * x ^ 2 + 6 * x * y + 5 * y ^ 2) / 128
'D1Bound5.lowDegreeHalfCoefficient_two' depends on axioms: [propext, Classical.choice, Quot.sound]
'D1Bound5.lowDegreeHalfCoefficient_three' depends on axioms: [propext, Classical.choice, Quot.sound]
'D1Bound5.lowDegreeHalfCoefficient_four' depends on axioms: [propext, Classical.choice, Quot.sound]
