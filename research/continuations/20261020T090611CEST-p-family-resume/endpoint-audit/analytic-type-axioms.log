ANALYTIC_AXIOMS_PASS D1Bound5.finiteP_residual_norm_lt: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finitePRowForm_eq_root_sum: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finitePRowForm_norm_lt: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.full_ring_finiteP_inequality: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.full_ring_finiteP_closed_interval_excluded: [propext, Classical.choice, Quot.sound]
D1Bound5.finiteP_residual_norm_lt : ∀ (a b s c : ℂ),
  1 ≤ ‖a‖ →
    ‖a‖ ≤ ‖b‖ →
      ‖b‖ ≤ ‖s‖ →
        1000 ≤ ‖a‖ * ‖c‖ → ∀ (i : Fin 4), ‖D1Bound5.finitePResidual a b s c i‖ < 3 * ‖s‖ ^ 2 / (‖a‖ ^ 3 * ‖c‖ ^ 5)
D1Bound5.finitePRowForm_eq_root_sum : ∀ (a b s c z rA rB rS : ℂ) (i : Fin 4),
  D1Bound5.finitePRowForm a b s c z rA rB rS i =
    D1Bound5.finitePDividedMatrix a b s c i 0 * z + ∑ j, D1Bound5.finitePRootColumn a b s c i j * ![rA, rB, rS] j
D1Bound5.finitePRowForm_norm_lt : ∀ (a b s c z rA rB rS : ℂ),
  a ≠ 0 →
    b ≠ 0 →
      s ≠ 0 →
        z ≠ 0 →
          1 ≤ ‖a‖ →
            ‖a‖ ≤ ‖b‖ →
              ‖b‖ ≤ ‖s‖ →
                200 ≤ ‖c‖ →
                  1000 ≤ ‖a‖ * ‖c‖ →
                    (∀ (j : Fin 3),
                        ‖(1 + 1 / (![a, b, s] j * c)) ^ (1 / 2) - ![rA, rB, rS] j / (![a, b, s] j * z)‖ ≤
                          101 / 100 * ‖c‖ / (‖![a, b, s] j‖ * ‖z‖ ^ 2)) →
                      ∀ (i : Fin 4),
                        ‖D1Bound5.finitePRowForm a b s c z rA rB rS i‖ <
                          2400 * max (‖b‖ * ‖s‖ ^ 3) (‖b‖ ^ 3 * ‖s‖ ^ 2) * ‖c‖ ^ 3 / ‖z‖ +
                            3 * ‖s‖ ^ 2 * ‖z‖ / (‖a‖ ^ 3 * ‖c‖ ^ 5)
@D1Bound5.full_ring_finiteP_inequality : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) {S : Finset (𝓞 K)},
      D1Bound5.IsD1 S →
        ∀ (a : Fin 3 → 𝓞 K) (c d : 𝓞 K),
          (∀ (j : Fin 3), a j ∈ S) →
            c ∈ S →
              d ∈ S →
                Function.Injective a →
                  (∀ (j : Fin 3), a j ≠ c) →
                    (∀ (j : Fin 3), a j ≠ d) →
                      c ≠ d →
                        (Monotone fun j => ‖phi ↑(a j)‖) →
                          200 * ‖phi ↑(a 2)‖ ≤ ‖phi ↑c‖ →
                            ‖phi ↑c‖ ≤ ‖phi ↑d‖ →
                              1000 ≤ ‖phi ↑(a 0)‖ * ‖phi ↑c‖ →
                                ∃ z,
                                  z ^ 2 = c * d + 1 ∧
                                    1 <
                                      2400 *
                                              max (‖phi ↑(a 1)‖ * ‖phi ↑(a 2)‖ ^ 3)
                                                (‖phi ↑(a 1)‖ ^ 3 * ‖phi ↑(a 2)‖ ^ 2) *
                                            ‖phi ↑c‖ ^ 3 /
                                          ‖phi ↑z‖ +
                                        3 * ‖phi ↑(a 2)‖ ^ 2 * ‖phi ↑z‖ / (‖phi ↑(a 0)‖ ^ 3 * ‖phi ↑c‖ ^ 5)
@D1Bound5.full_ring_finiteP_closed_interval_excluded : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) {S : Finset (𝓞 K)},
      D1Bound5.IsD1 S →
        ∀ (a : Fin 3 → 𝓞 K) (c d : 𝓞 K),
          (∀ (j : Fin 3), a j ∈ S) →
            c ∈ S →
              d ∈ S →
                Function.Injective a →
                  (∀ (j : Fin 3), a j ≠ c) →
                    (∀ (j : Fin 3), a j ≠ d) →
                      c ≠ d →
                        (Monotone fun j => ‖phi ↑(a j)‖) →
                          200 * ‖phi ↑(a 2)‖ ≤ ‖phi ↑c‖ →
                            ‖phi ↑c‖ ≤ ‖phi ↑d‖ →
                              1000 ≤ ‖phi ↑(a 0)‖ * ‖phi ↑c‖ →
                                4 * 2400 ^ 2 *
                                          max (‖phi ↑(a 1)‖ * ‖phi ↑(a 2)‖ ^ 3) (‖phi ↑(a 1)‖ ^ 3 * ‖phi ↑(a 2)‖ ^ 2) ^
                                            2 *
                                        ‖phi ↑c‖ ^ 5 /
                                      (1 - 1 / 4000) ≤
                                    ‖phi ↑d‖ →
                                  ‖phi ↑d‖ ≤
                                      ‖phi ↑(a 0)‖ ^ 6 * ‖phi ↑c‖ ^ 9 / (36 * ‖phi ↑(a 2)‖ ^ 4 * (1 + 1 / 4000)) →
                                    False
