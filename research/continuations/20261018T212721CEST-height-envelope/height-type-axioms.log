D1Bound5.ordinaryLog10 : ℝ → ℝ
D1Bound5.ordinaryLog10_base_pos : 0 < Real.log 10
D1Bound5.ordinaryLog10_mul : ∀ (x y : ℝ),
  x ≠ 0 → y ≠ 0 → D1Bound5.ordinaryLog10 (x * y) = D1Bound5.ordinaryLog10 x + D1Bound5.ordinaryLog10 y
D1Bound5.ordinaryLog10_pow : ∀ (x : ℝ) (n : ℕ), D1Bound5.ordinaryLog10 (x ^ n) = ↑n * D1Bound5.ordinaryLog10 x
D1Bound5.ordinaryLog10_ten : D1Bound5.ordinaryLog10 10 = 1
@D1Bound5.ordinaryLog10_strictMono : ∀ {x y : ℝ}, 0 < x → x < y → D1Bound5.ordinaryLog10 x < D1Bound5.ordinaryLog10 y
@D1Bound5.ordinaryLog10_mono : ∀ {x y : ℝ}, 0 < x → x ≤ y → D1Bound5.ordinaryLog10 x ≤ D1Bound5.ordinaryLog10 y
@D1Bound5.ordinaryLog10_nonneg : ∀ {x : ℝ}, 1 ≤ x → 0 ≤ D1Bound5.ordinaryLog10 x
D1Bound5.ordinaryLog10_lt_of_pow_lt : ∀ (x : ℝ) (m n : ℕ), 0 < x → x ^ n < 10 ^ m → ↑n * D1Bound5.ordinaryLog10 x < ↑m
D1Bound5.ordinaryLog10_two_lt : D1Bound5.ordinaryLog10 2 < 2 / 5
D1Bound5.ordinaryLog10_unit_parameters : D1Bound5.ordinaryLog10 42 < 163 / 100 ∧
  -(2 / 5) < D1Bound5.ordinaryLog10 (2 / 5) ∧ D1Bound5.ordinaryLog10 253 < 241 / 100
D1Bound5.ordinary_height_envelope_from_orders : ∀ (B C D Z R h r u : ℝ),
  1 ≤ B →
    1 < C →
      0 < D →
        1 ≤ Z →
          0 < R →
            C * D < 2 * Z ^ 2 →
              D1Bound5.ordinaryLog10 (42 * B ^ 3 * C) < D1Bound5.ordinaryLog10 C + h →
                2 * D1Bound5.ordinaryLog10 C + r < D1Bound5.ordinaryLog10 R →
                  D1Bound5.ordinaryLog10 (253 * B ^ 2) < u →
                    h - r < D1Bound5.ordinaryLog10 C →
                      0 < 2 * D1Bound5.ordinaryLog10 C + r →
                        (∀ (k : ℕ), 1 ≤ k → 1 < 3 * C * (42 * B ^ 3 * C) ^ k / (B * Z) + Z / (2 * R ^ k)) →
                          D1Bound5.ordinaryLog10 D <
                            7 * D1Bound5.ordinaryLog10 C + (4 * u + 8 * h - 4 * r) +
                                (2 * u * r + (4 * u + 8 * h - 4 * r) * (h - r)) / (D1Bound5.ordinaryLog10 C - (h - r)) +
                              2 / 5
D1Bound5.unit_pair_residual_rate_lower : ∀ (S : ℝ), 1000 ≤ S → 2 / 5 * S ^ 2 < 27 * (S - 1) ^ 2 / 64
@D1Bound5.ordinaryLog10_ge_four : ∀ {S : ℝ}, 10000 ≤ S → 4 ≤ D1Bound5.ordinaryLog10 S
D1Bound5.unit_pair_height_upper_from_orders : ∀ (S D Z : ℝ),
  10000 ≤ S →
    0 < D →
      1 ≤ Z →
        S * D < 2 * Z ^ 2 →
          (∀ (k : ℕ), 1 ≤ k → 1 < 3 * S * (42 * S) ^ k / Z + Z / (2 * (27 * (S - 1) ^ 2 / 64) ^ k)) →
            D1Bound5.ordinaryLog10 D <
              7 * D1Bound5.ordinaryLog10 S + 617 / 25 + 118401 / 2500 / (D1Bound5.ordinaryLog10 S - 203 / 100)
D1Bound5.unit_pair_height_cutoff_from_orders : ∀ (S D Z : ℝ),
  0 < S →
    0 < D →
      1 ≤ Z →
        S * D < 2 * Z ^ 2 →
          S ^ 27 / 8192 < D →
            (10000 ≤ S → ∀ (k : ℕ), 1 ≤ k → 1 < 3 * S * (42 * S) ^ k / Z + Z / (2 * (27 * (S - 1) ^ 2 / 64) ^ k)) →
              S < 10000
