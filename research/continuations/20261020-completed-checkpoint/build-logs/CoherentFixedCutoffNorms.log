  [inst_1 : DecidableEq ι] [Nonempty ι] (a : ι → ℂ) (f : ℕ → ℂ) (m : ℕ) (C ρ t : ℝ),
  0 ≤ C →
    0 ≤ ρ →
      0 ≤ t →
        (∀ (i : ι), ‖a i‖ ≤ ρ) →
          ρ * t < 1 →
            (∀ (j : ℕ), ‖f (m + (j + 1))‖ ≤ C * t ^ (m + (j + 1))) →
              (Summable fun j => f (m + (j + 1)) * (MvPolynomial.aeval a) (MvPolynomial.hsymm ι ℂ (j + 1))) ∧
                ‖∑' (j : ℕ), f (m + (j + 1)) * (MvPolynomial.aeval a) (MvPolynomial.hsymm ι ℂ (j + 1))‖ ≤
                  C * t ^ m * (1 / (1 - ρ * t) ^ Fintype.card ι - 1)
