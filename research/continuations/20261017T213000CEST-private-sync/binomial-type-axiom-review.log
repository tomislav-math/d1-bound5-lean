HALF_BINOMIAL_AXIOMS D1Bound5.halfBinomialCoeff_recurrence: [propext, Classical.choice, Quot.sound]
HALF_BINOMIAL_AXIOMS D1Bound5.halfBinomialCoeff_signed_nonneg: [propext, Classical.choice, Quot.sound]
HALF_BINOMIAL_AXIOMS D1Bound5.halfBinomialCoeff_abs_next_le: [propext, Classical.choice, Quot.sound]
HALF_BINOMIAL_AXIOMS D1Bound5.halfBinomialCoeff_abs_antitone: [propext, Classical.choice, Quot.sound]
HALF_BINOMIAL_AXIOMS D1Bound5.halfBinomialCoeff_abs_le_half: [propext, Classical.choice, Quot.sound]
HALF_BINOMIAL_AXIOMS D1Bound5.halfBinomialCoeff_signed_pair_nonneg: [propext, Classical.choice, Quot.sound]
