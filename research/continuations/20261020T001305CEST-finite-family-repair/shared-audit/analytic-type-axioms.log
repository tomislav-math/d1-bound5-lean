@D1Bound5.unequalPolePolynomial : {I : Type u_1} →
  [Fintype I] →
    [DecidableEq I] → {F : Type u_2} → [inst : Field F] → [CharZero F] → (I → F) → (I → ℕ) → ℕ → F → I → Polynomial F
@D1Bound5.unequalPolePolynomial_residual_hasSum : ∀ {I : Type u_1} [inst : Fintype I] [inst_1 : DecidableEq I]
  (a : I → ℂ) (e : I → ℕ) (k : ℕ) (ν x : ℂ),
  (∀ (j : I), ‖a j * x‖ < 1) →
    HasSum
      (fun r =>
        (PowerSeries.coeff r)
            (∑ j,
              ↑(D1Bound5.unequalPolePolynomial a e k ν j) *
                (PowerSeries.rescale (a j)) (PowerSeries.binomialSeries ℂ ν)) *
          x ^ r)
      (∑ j, Polynomial.eval x (D1Bound5.unequalPolePolynomial a e k ν j) * (1 + a j * x) ^ ν)
@D1Bound5.unequalPolePolynomial_residual_coeff : ∀ {I : Type u_1} [inst : Fintype I] [inst_1 : DecidableEq I]
  {F : Type u_2} [inst_2 : Field F] [inst_3 : CharZero F] (a : I → F) (e : I → ℕ) (k : ℕ),
  (∀ (j : I), e j ≤ k) →
    ∀ (ν : F) (r : ℕ),
      (PowerSeries.coeff r)
          (∑ j,
            ↑(D1Bound5.unequalPolePolynomial a e k ν j) *
              (PowerSeries.rescale (a j)) (PowerSeries.binomialSeries F ν)) =
        Ring.choose (↑k + ν) r * ∑ j, D1Bound5.bennettLocalResidue a e (Polynomial.X ^ r) j
@D1Bound5.unequalPolePolynomial_residual_coeff_zero : ∀ {I : Type u_1} [inst : Fintype I] [inst_1 : DecidableEq I]
  {F : Type u_2} [inst_2 : Field F] [inst_3 : CharZero F] (a : I → F),
  Function.Injective a →
    ∀ (e : I → ℕ) (k : ℕ),
      (∀ (j : I), e j ≤ k) →
        ∀ (ν : F),
          ∀ r < ∑ j, (e j + 1) - 1,
            (PowerSeries.coeff r)
                (∑ j,
                  ↑(D1Bound5.unequalPolePolynomial a e k ν j) *
                    (PowerSeries.rescale (a j)) (PowerSeries.binomialSeries F ν)) =
              0
@D1Bound5.unequalPolePolynomial_residual_tail_hasSum : ∀ {I : Type u_1} [inst : Fintype I] [inst_1 : DecidableEq I]
  (a : I → ℂ),
  Function.Injective a →
    ∀ (e : I → ℕ) (k : ℕ),
      (∀ (j : I), e j ≤ k) →
        ∀ (ν x : ℂ),
          (∀ (j : I), ‖a j * x‖ < 1) →
            HasSum
              (fun t =>
                (Ring.choose (↑k + ν) (∑ j, (e j + 1) - 1 + t) *
                    ∑ j, D1Bound5.bennettLocalResidue a e (Polynomial.X ^ (∑ j, (e j + 1) - 1 + t)) j) *
                  x ^ (∑ j, (e j + 1) - 1 + t))
              (∑ j, Polynomial.eval x (D1Bound5.unequalPolePolynomial a e k ν j) * (1 + a j * x) ^ ν)
@D1Bound5.unequalPolePolynomial_residual_norm_le : ∀ {I : Type u_1} [inst : Fintype I] [inst_1 : DecidableEq I]
  (a : I → ℂ),
  Function.Injective a →
    ∀ (e : I → ℕ) (q : I) (k : ℕ),
      (∀ (j : I), e j ≤ k) →
        ∀ (ν ρ : ℝ) (x : ℂ),
          ↑k + ν < ↑(∑ j, (e j + 1) - 1) →
            0 ≤ ρ →
              (∀ (j : I), ‖a j‖ ≤ ρ) →
                ρ * ‖x‖ < 1 →
                  ‖∑ j, Polynomial.eval x (D1Bound5.unequalPolePolynomial a e k (↑ν) j) * (1 + a j * x) ^ ↑ν‖ ≤
                    |Ring.choose (↑k + ν) (∑ j, (e j + 1) - 1)| * ‖x‖ ^ (∑ j, (e j + 1) - 1) /
                      (1 - ρ * ‖x‖) ^ (↑(∑ j, (e j + 1) - 1) - (↑k + ν))
D1Bound5.finiteUnequalOrders : ℕ → ℕ → Fin 3 → Fin 3 → ℕ
D1Bound5.finiteUnequalOrders_add_one : ∀ (k m : ℕ),
  1 ≤ k → 1 ≤ m → ∀ (i j : Fin 3), D1Bound5.finiteUnequalOrders k m i j + 1 = ![m, k, k] j + if i = j then 1 else 0
D1Bound5.finiteUnequalOrders_le : ∀ (k m : ℕ), m ≤ k → ∀ (i j : Fin 3), D1Bound5.finiteUnequalOrders k m i j ≤ k
D1Bound5.finiteUnequalOrders_total : ∀ (k m : ℕ),
  1 ≤ k → 1 ≤ m → ∀ (i : Fin 3), ∑ j, (D1Bound5.finiteUnequalOrders k m i j + 1) = m + 2 * k + 1
@D1Bound5.finiteUnequalOtherPoles_zero : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (x y : F) (k m : ℕ),
  1 ≤ k →
    1 ≤ m →
      ∀ (i : Fin 3),
        D1Bound5.bennettLocalReciprocal (D1Bound5.bennettTwoNodes x y) (D1Bound5.finiteUnequalOrders k m i) 0 =
          D1Bound5.bennettPoleSeries (-y) (k + if i = 1 then 1 else 0) *
            D1Bound5.bennettPoleSeries (-x) (k + if i = 2 then 1 else 0)
@D1Bound5.finiteUnequalOtherPoles_one : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (x y : F) (k m : ℕ),
  1 ≤ k →
    1 ≤ m →
      ∀ (i : Fin 3),
        D1Bound5.bennettLocalReciprocal (D1Bound5.bennettTwoNodes x y) (D1Bound5.finiteUnequalOrders k m i) 1 =
          D1Bound5.bennettPoleSeries y (m + if i = 0 then 1 else 0) *
            D1Bound5.bennettPoleSeries (y - x) (k + if i = 2 then 1 else 0)
@D1Bound5.finiteUnequalOtherPoles_two : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (x y : F) (k m : ℕ),
  1 ≤ k →
    1 ≤ m →
      ∀ (i : Fin 3),
        D1Bound5.bennettLocalReciprocal (D1Bound5.bennettTwoNodes x y) (D1Bound5.finiteUnequalOrders k m i) 2 =
          D1Bound5.bennettPoleSeries x (m + if i = 0 then 1 else 0) *
            D1Bound5.bennettPoleSeries (x - y) (k + if i = 1 then 1 else 0)
@D1Bound5.finiteUnequalClearedEntry : {F : Type u_1} →
  [inst : Field F] → [CharZero F] → F → F → F → ℕ → ℕ → Fin 3 → Fin 3 → F
@D1Bound5.finiteUnequalClearedEntry_eq_scaled_residue : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F]
  (x y c : F),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        ∀ (k m : ℕ),
          m ≤ k →
            ∀ (i j : Fin 3),
              D1Bound5.finiteUnequalClearedEntry x y c k m i j =
                4 ^ k * x ^ m * y ^ m * (x - y) ^ (2 * k) * (x * y * c) ^ k *
                  Polynomial.eval (x * y * c)⁻¹
                    (D1Bound5.unequalPolePolynomial (D1Bound5.bennettTwoNodes x y) (D1Bound5.finiteUnequalOrders k m i)
                      k (1 / 2) j)
D1Bound5.finiteUnequal_residual_scale : ∀ (X Y C delta : ℝ),
  X ≠ 0 →
    Y ≠ 0 →
      C ≠ 0 →
        ∀ (k m : ℕ),
          4 ^ k * X ^ m * Y ^ m * delta ^ (2 * k) * (X * Y * C) ^ k * (X * Y * C)⁻¹ ^ (m + 2 * k) =
            4 ^ k * delta ^ (2 * k) / (X ^ k * Y ^ k * C ^ (m + k))
D1Bound5.finiteUnequalClearedEntry_residual_norm_le : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        x ≠ y →
          ‖x‖ ≤ ‖y‖ →
            1 < ‖x‖ * ‖c‖ →
              ∀ (k m : ℕ),
                1 ≤ k →
                  1 ≤ m →
                    m ≤ k →
                      ↑k + 1 / 2 < ↑(m + 2 * k) →
                        ∀ (i : Fin 3),
                          ‖∑ j,
                                D1Bound5.finiteUnequalClearedEntry x y c k m i j *
                                  (1 + D1Bound5.bennettTwoNodes x y j * (x * y * c)⁻¹) ^ (1 / 2)‖ ≤
                            4 ^ k * ‖x - y‖ ^ (2 * k) / (‖x‖ ^ k * ‖y‖ ^ k * ‖c‖ ^ (m + k)) *
                                |Ring.choose (↑k + 1 / 2) (m + 2 * k)| /
                              (1 - 1 / (‖x‖ * ‖c‖)) ^ (↑(m + 2 * k) - (↑k + 1 / 2))
D1Bound5.finitePolynomial_norm_le : ∀ (k : ℕ) (a : Fin (k + 1) → ℂ) (c : ℂ),
  ‖∑ ell, a ell * c ^ ↑ell‖ ≤ ∑ ell, ‖a ell‖ * ‖c‖ ^ ↑ell
D1Bound5.finitePolynomial_two_columns_norm_le : ∀ (k d0 : ℕ) (p : Fin 2 → Fin (k + 1) → ℂ) (v : Fin (k + 1) → ℝ) (c : ℂ)
  (Y : ℝ),
  (∀ (ell : Fin (k + 1)), ‖p 0 ell‖ + ‖p 1 ell‖ ≤ v ell * Y ^ (d0 + ↑ell)) →
    ‖∑ ell, p 0 ell * c ^ ↑ell‖ + ‖∑ ell, p 1 ell * c ^ ↑ell‖ ≤ Y ^ d0 * ∑ ell, v ell * (Y * ‖c‖) ^ ↑ell
D1Bound5.finitePolynomial_power_majorization : ∀ (T : ℝ),
  1000 ≤ T → ∀ (k ell : ℕ), ell ≤ k → T ^ ell ≤ T ^ k / 1000 ^ (k - ell)
D1Bound5.finitePolynomial_height_scalar : ∀ (k : ℕ) (v : Fin (k + 1) → ℝ),
  (∀ (ell : Fin (k + 1)), 0 ≤ v ell) →
    ∀ (M T : ℝ),
      1000 ≤ T → 101 / 100 * ∑ ell, v ell / 1000 ^ (k - ↑ell) < M → 101 / 100 * ∑ ell, v ell * T ^ ↑ell < M * T ^ k
@D1Bound5.finiteA_choose_two : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (r : F),
  Ring.choose r 2 = r * (r - 1) / 2
@D1Bound5.finiteA_choose_three : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (r : F),
  Ring.choose r 3 = r * (r - 1) * (r - 2) / 6
@D1Bound5.finiteA_choose_four : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (r : F),
  Ring.choose r 4 = r * (r - 1) * (r - 2) * (r - 3) / 24
@D1Bound5.finiteA_choose_five : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (r : F),
  Ring.choose r 5 = r * (r - 1) * (r - 2) * (r - 3) * (r - 4) / 120
