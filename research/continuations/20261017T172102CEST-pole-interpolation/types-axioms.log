POLE_TAIL_AXIOMS D1Bound5.reciprocal_pole_finite_tail: [propext, Classical.choice, Quot.sound]
POLE_TAIL_AXIOMS D1Bound5.weighted_poles_finite_tail: [propext, Classical.choice, Quot.sound]
POLE_TAIL_AXIOMS D1Bound5.reciprocal_pole_hsymm_finite_tail: [propext, Classical.choice, Quot.sound]
POLE_TAIL_AXIOMS_PASS: 3 theorems
@D1Bound5.reciprocal_pole_finite_tail : ∀ {F : Type u_1} [inst : Field F] (a z : F),
  a ≠ 0 → a ≠ z → ∀ (n : ℕ), (a - z)⁻¹ = ∑ k ∈ Finset.range n, z ^ k / a ^ (k + 1) + z ^ n / (a ^ n * (a - z))
@D1Bound5.weighted_poles_finite_tail : ∀ {F : Type u_1} {ι : Type u_2} [inst : Field F] [DecidableEq ι] (s : Finset ι)
  (a w : ι → F) (z : F),
  (∀ i ∈ s, a i ≠ 0) →
    (∀ i ∈ s, a i ≠ z) →
      ∀ (n : ℕ),
        ∑ i ∈ s, w i / (a i - z) =
          ∑ k ∈ Finset.range n, z ^ k * ∑ i ∈ s, w i / a i ^ (k + 1) + z ^ n * ∑ i ∈ s, w i / (a i ^ n * (a i - z))
@D1Bound5.reciprocal_pole_hsymm_finite_tail : ∀ {F : Type u_1} {ι : Type u_2} [inst : Field F] [inst_1 : DecidableEq ι]
  (s : Finset ι) (a : ι → F),
  s.Nonempty →
    Set.InjOn a ↑s →
      (∀ i ∈ s, a i ≠ 0) →
        ∀ (z : F),
          (∀ i ∈ s, a i ≠ z) →
            ∀ (n : ℕ),
              ∑ i ∈ s, (∏ j ∈ s.erase i, (a i - a j))⁻¹ / (a i - z) =
                ∑ k ∈ Finset.range n,
                    z ^ k *
                      ((-1) ^ (s.card - 1) * (∏ i ∈ s, a i)⁻¹ *
                        (MvPolynomial.aeval fun i => (a ↑i)⁻¹) (MvPolynomial.hsymm (↥s) F k)) +
                  z ^ n * ∑ i ∈ s, (∏ j ∈ s.erase i, (a i - a j))⁻¹ / (a i ^ n * (a i - z))
