@D1Bound5.IsD1Tuple.three_anchor_general_detailed_alternative : ∀ {K : Type u_1} [inst : Field K]
  [inst_1 : NumberField K] [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (a : Fin 5 → NumberField.RingOfIntegers K),
      D1Bound5.IsD1Tuple a →
        (Monotone fun i => ‖phi ↑(a i)‖) →
          1000 ≤ ‖phi ↑(a 3)‖ →
            4 * ‖phi ↑(a 2)‖ ≤ ‖phi ↑(a 3)‖ →
              5 * ‖phi ↑(a 0)‖ * ‖phi ↑(a 1)‖ * ‖phi ↑(a 2)‖ * ‖phi ↑(a 3)‖ ^ 2 < ‖phi ↑(a 4)‖ ∧
                  ‖phi ↑(a 4)‖ < 15 * ‖phi ↑(a 0)‖ * ‖phi ↑(a 1)‖ * ‖phi ↑(a 2)‖ * ‖phi ↑(a 3)‖ ^ 2 ∨
                ‖phi ↑(a 4)‖ < 101 * ‖phi ↑(a 1)‖ ^ 2 * ‖phi ↑(a 2)‖ ^ 4 / ‖phi ↑(a 3)‖ ∨
                  ‖phi ↑(a 0)‖ ^ 2 * ‖phi ↑(a 3)‖ ^ 5 / (37 * ‖phi ↑(a 2)‖ ^ 2) < ‖phi ↑(a 4)‖
D1Bound5.three_small_pair_alternative_scalar : ∀ (A B S P Q : ℝ),
  1 ≤ A →
    A ≤ B →
      B ≤ S →
        S < 3 →
          1000 ≤ P →
            P ≤ Q →
              5 * A * B * S * P ^ 2 < Q ∧ Q < 15 * A * B * S * P ^ 2 ∨
                  Q < 101 * B ^ 2 * S ^ 4 / P ∨ A ^ 2 * P ^ 5 / (37 * S ^ 2) < Q →
                5 * P ^ 2 < Q ∧ Q < 405 * P ^ 2 ∨ P ^ 5 / 400 < Q
@D1Bound5.IsD1Tuple.three_small_pair_alternative : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (a : Fin 5 → NumberField.RingOfIntegers K),
      D1Bound5.IsD1Tuple a →
        (Monotone fun i => ‖phi ↑(a i)‖) →
          ‖phi ↑(a 2)‖ < 3 →
            1000 ≤ ‖phi ↑(a 3)‖ →
              5 * ‖phi ↑(a 3)‖ ^ 2 < ‖phi ↑(a 4)‖ ∧ ‖phi ↑(a 4)‖ < 405 * ‖phi ↑(a 3)‖ ^ 2 ∨
                ‖phi ↑(a 3)‖ ^ 5 / 400 < ‖phi ↑(a 4)‖
D1Bound5.three_small_pair_growth : ∀ (P Q : ℝ),
  1000 ≤ P → 5 * P ^ 2 < Q ∧ Q < 405 * P ^ 2 ∨ P ^ 5 / 400 < Q → 5 * P ^ 2 < Q
D1Bound5.ordinary_height_power_upper : ∀ (P Q : ℝ),
  10 ^ 40 ≤ P →
    0 < Q → D1Bound5.ordinaryLog10 Q < D1Bound5.twoSmallHeightEnvelope (D1Bound5.ordinaryLog10 P) → Q < 10 ^ 60 * P ^ 7
D1Bound5.three_small_tenth_growth_impossible : ∀ (U W : ℝ),
  10 ^ 40 ≤ U → U ^ 10 / 32000 < W → W < 10 ^ 60 * U ^ 7 → False
D1Bound5.three_small_three_large_impossible : ∀ (U V W : ℝ),
  10 ^ 40 ≤ U →
    5 * U ^ 2 < V ∧ V < 405 * U ^ 2 ∨ U ^ 5 / 400 < V →
      5 * V ^ 2 < W ∧ W < 405 * V ^ 2 ∨ V ^ 5 / 400 < W →
        5 * U ^ 2 < W ∧ W < 405 * U ^ 2 ∨ U ^ 5 / 400 < W → W < 10 ^ 60 * U ^ 7 → False
@D1Bound5.IsD1Tuple.three_small_pair_at : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (a : Fin 6 → NumberField.RingOfIntegers K),
      D1Bound5.IsD1Tuple a →
        (Monotone fun i => ‖phi ↑(a i)‖) →
          ‖phi ↑(a 2)‖ < 3 →
            ∀ (i j : Fin 6),
              3 ≤ i →
                i < j →
                  1000 ≤ ‖phi ↑(a i)‖ →
                    5 * ‖phi ↑(a i)‖ ^ 2 < ‖phi ↑(a j)‖ ∧ ‖phi ↑(a j)‖ < 405 * ‖phi ↑(a i)‖ ^ 2 ∨
                      ‖phi ↑(a i)‖ ^ 5 / 400 < ‖phi ↑(a j)‖
@D1Bound5.IsD1Tuple.three_small_not_three_large_extensions : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
