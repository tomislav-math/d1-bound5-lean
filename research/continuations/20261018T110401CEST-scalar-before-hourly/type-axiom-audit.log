D1Bound5.ordinary_height_scalar_envelope : ∀ (x z d p q h r u : ℝ),
  0 ≤ z →
    0 ≤ q →
      2 * x + r < p →
        0 < 2 * x + r →
          q < x + h →
            h - r < x →
              z * (p - q) < (2 * x + u) * p →
                d < 2 / 5 - x + 2 * z →
                  d <
                    7 * x + (4 * u + 8 * h - 4 * r) + (2 * u * r + (4 * u + 8 * h - 4 * r) * (h - r)) / (x - (h - r)) +
                      2 / 5
D1Bound5.unit_pair_height_cutoff_scalar : ∀ (s d : ℝ),
  4 ≤ s → 27 * s - 4 < d → d < 7 * s + 617 / 25 + 118401 / 2500 / (s - 203 / 100) → False
