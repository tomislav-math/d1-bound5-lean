    Matrix.of fun i j => Polynomial.eval (a i) (D1Bound5.bennettFirstOrderMonomial N t ↑j)
@D1Bound5.bennettFirstOrderOperator : {F : Type u_1} →
  [Field F] → {n : ℕ} → (Fin n → F) → F → F → Matrix (Fin n) (Fin n) F
@D1Bound5.bennettFirstOrderOperator_mul_vandermonde : ∀ {F : Type u_1} [inst : Field F] {n : ℕ} (a : Fin n → F),
  Function.Injective a →
    ∀ (N t : F),
      D1Bound5.bennettFirstOrderOperator a N t * Matrix.vandermonde a =
        Matrix.vandermonde a * D1Bound5.bennettFirstOrderCoefficients N t
@D1Bound5.bennettFirstOrderOperator_det : ∀ {F : Type u_1} [inst : Field F] {n : ℕ} (a : Fin n → F),
  Function.Injective a → ∀ (N t : F), (D1Bound5.bennettFirstOrderOperator a N t).det = ∏ j, (t - ↑↑j)
@D1Bound5.bennettFirstOrderReverse_det : ∀ {F : Type u_1} [inst : Field F] {n : ℕ} (a : Fin n → F),
  Function.Injective a →
    ∀ (N t : F),
      ((Matrix.scalar (Fin n)) t - D1Bound5.lagrangeDifferentiation a * Matrix.diagonal fun i => N + a i).det =
        ∏ j, (t - ↑↑j)
@D1Bound5.bennettFirstOrderResidue : {F : Type u_1} →
  [Field F] → {n : ℕ} → (Fin n → F) → F → F → Matrix (Fin n) (Fin n) F
@D1Bound5.bennettFirstOrderResidue_det : ∀ {F : Type u_1} [inst : Field F] {n : ℕ} (a : Fin n → F),
  Function.Injective a →
    ∀ (N t : F),
      (D1Bound5.bennettFirstOrderResidue a N t).det =
        (N⁻¹ ^ n * ∏ i, Lagrange.nodalWeight Finset.univ a i) * ∏ j, (t - ↑↑j)
@D1Bound5.eval_derivative_basisDivisor : ∀ {F : Type u_1} [inst : Field F] (x y z : F),
  Polynomial.eval z (Polynomial.derivative (Lagrange.basisDivisor x y)) = (x - y)⁻¹
@D1Bound5.lagrangeDifferentiation_diagonal : ∀ {F : Type u_1} [inst : Field F] {n : ℕ} (a : Fin n → F),
  Function.Injective a →
    ∀ (i : Fin n), D1Bound5.lagrangeDifferentiation a i i = ∑ j ∈ Finset.univ.erase i, (a i - a j)⁻¹
@D1Bound5.lagrange_basis_eq_weight_mul_nodal_erase : ∀ {F : Type u_1} [inst : Field F] {n : ℕ} (a : Fin n → F)
  (j : Fin n),
  Lagrange.basis Finset.univ a j =
    Polynomial.C (Lagrange.nodalWeight Finset.univ a j) * Lagrange.nodal (Finset.univ.erase j) a
@D1Bound5.nodalWeight_mul_lagrangeDifferentiation_offDiagonal : ∀ {F : Type u_1} [inst : Field F] {n : ℕ}
  (a : Fin n → F),
  Function.Injective a →
    ∀ (i j : Fin n),
      i ≠ j →
        Lagrange.nodalWeight Finset.univ a i * D1Bound5.lagrangeDifferentiation a i j =
          Lagrange.nodalWeight Finset.univ a j / (a i - a j)
@D1Bound5.bennettFirstOrderExplicit : {F : Type u_1} →
  [Field F] → {n : ℕ} → (Fin n → F) → F → F → Matrix (Fin n) (Fin n) F
@D1Bound5.bennettFirstOrderResidue_eq_explicit : ∀ {F : Type u_1} [inst : Field F] {n : ℕ} (a : Fin n → F),
  Function.Injective a → ∀ (N t : F), D1Bound5.bennettFirstOrderResidue a N t = D1Bound5.bennettFirstOrderExplicit a N t
@D1Bound5.bennettFirstOrderExplicit_det : ∀ {F : Type u_1} [inst : Field F] {n : ℕ} (a : Fin n → F),
  Function.Injective a →
    ∀ (N t : F),
      (D1Bound5.bennettFirstOrderExplicit a N t).det =
        (N⁻¹ ^ n * ∏ i, Lagrange.nodalWeight Finset.univ a i) * ∏ j, (t - ↑↑j)
@D1Bound5.three_halves_sub_natCast_ne_zero : ∀ {F : Type u_1} [inst : Field F] [CharZero F] (j : ℕ), 3 / 2 - ↑j ≠ 0
@D1Bound5.bennettFirstOrderExplicit_det_ne_zero : ∀ {F : Type u_1} [inst : Field F] {n : ℕ} [CharZero F]
  (a : Fin n → F), Function.Injective a → ∀ (N : F), N ≠ 0 → (D1Bound5.bennettFirstOrderExplicit a N (3 / 2)).det ≠ 0
@D1Bound5.bennettPoleSeries : {F : Type u_1} → [inst : Field F] → [CharZero F] → F → ℕ → PowerSeries F
@D1Bound5.bennettPoleSeries_coeff : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (d : F) (k h : ℕ),
  (PowerSeries.coeff h) (D1Bound5.bennettPoleSeries d k) = Ring.choose (-↑k) h * d⁻¹ ^ (k + h)
@D1Bound5.bennettNegativeBinomial_mul : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (k : ℕ),
  (1 + PowerSeries.X) ^ k * PowerSeries.binomialSeries F (-↑k) = 1
@D1Bound5.bennettPoleSeries_mul : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (d : F),
  d ≠ 0 → ∀ (k : ℕ), (PowerSeries.C d + PowerSeries.X) ^ k * D1Bound5.bennettPoleSeries d k = 1
