D1Bound5.halfBinomialCoeff_hasSum_cpow : ∀ (z : ℂ),
  ‖z‖ < 1 → HasSum (fun n => ↑(D1Bound5.halfBinomialCoeff n) * z ^ n) ((1 + z) ^ (1 / 2))
D1Bound5.halfBinomialCoeff_cauchy_hasSum : ∀ (x y z : ℂ),
  ‖x * z‖ < 1 →
    ‖y * z‖ < 1 →
      HasSum
        (fun n =>
