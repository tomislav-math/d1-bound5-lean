@D1Bound5.reciprocal_anchor_sum_eq_hsymm : ∀ {F : Type u_1} {ι : Type u_2} [inst : Field F] [inst_1 : DecidableEq ι]
  (s : Finset ι) (a : ι → F),
  s.Nonempty →
