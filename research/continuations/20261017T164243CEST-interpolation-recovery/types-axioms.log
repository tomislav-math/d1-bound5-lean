@D1Bound5.reciprocal_vandermonde_product : ∀ {F : Type u_1} {ι : Type u_2} [inst : Field F] [inst_1 : DecidableEq ι]
  (s : Finset ι) (a : ι → F),
  (∀ j ∈ s, a j ≠ 0) →
    ∀ i ∈ s,
      ∏ j ∈ s.erase i, (a i - a j) =
        (a i ^ (s.erase i).card * ∏ j ∈ s.erase i, a j) * ∏ j ∈ s.erase i, ((a j)⁻¹ - (a i)⁻¹)
@D1Bound5.reciprocal_anchor_weight_term : ∀ {F : Type u_1} {ι : Type u_2} [inst : Field F] [inst_1 : DecidableEq ι]
  (s : Finset ι) (a : ι → F),
  (∀ j ∈ s, a j ≠ 0) →
