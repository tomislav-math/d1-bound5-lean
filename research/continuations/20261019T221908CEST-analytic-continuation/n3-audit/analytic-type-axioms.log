ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3_choose_two: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3_choose_three: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3_bennett_identity: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3Residual: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3_beta: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3_residual_identity: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3RowFactor_ne_zero: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3_residual_norm_lt_point: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3_residual_norm_lt: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3Residual_explicit: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3RowForm_explicit: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.finiteN3RowForm_norm_lt: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.full_ring_finiteN3_integer: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.IsD1Tuple.finiteN3_inequality: [propext, Classical.choice, Quot.sound]
ANALYTIC_AXIOMS_PASS D1Bound5.IsD1Tuple.finiteN3_closed_interval_excluded: [propext, Classical.choice, Quot.sound]
@D1Bound5.finiteN3_choose_two : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (r : F),
  Ring.choose r 2 = r * (r - 1) / 2
@D1Bound5.finiteN3_choose_three : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (r : F),
  Ring.choose r 3 = r * (r - 1) * (r - 2) / 6
@D1Bound5.finiteN3_bennett_identity : ∀ {F : Type u_1} [inst : Field F] [inst_1 : CharZero F] (x y c : F),
  x ≠ 0 →
    y ≠ 0 →
      x ≠ y →
        ∀ (i j : Fin 3),
          D1Bound5.bennettTwoClearedEntry x y c 3 i j =
            4 * D1Bound5.finiteN3RowFactor x y i * D1Bound5.finiteN3Matrix x y c i j
D1Bound5.finiteN3Residual : ℂ → ℂ → ℂ → Fin 3 → ℂ
D1Bound5.finiteN3_beta : Real.Gamma (9 / 2) * Real.Gamma (11 / 2) / (Real.pi * Real.Gamma 10) = 35 / 65536
D1Bound5.finiteN3_residual_identity : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      x ≠ y →
        ∀ (i : Fin 3),
          4 * D1Bound5.finiteN3RowFactor x y i * D1Bound5.finiteN3Residual x y c i =
            ∑ j,
              D1Bound5.bennettTwoClearedEntry x y c 3 i j *
                (1 + D1Bound5.bennettTwoNodes x y j * (x * y * c)⁻¹) ^ (1 / 2)
D1Bound5.finiteN3RowFactor_ne_zero : ∀ (x y : ℂ),
  x ≠ 0 → y ≠ 0 → x ≠ y → ∀ (i : Fin 3), D1Bound5.finiteN3RowFactor x y i ≠ 0
D1Bound5.finiteN3_residual_norm_lt_point : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        x ≠ y →
          ‖x‖ ≤ ‖y‖ →
            1000 ≤ ‖x‖ * ‖c‖ →
              ∀ (i : Fin 3),
                ‖D1Bound5.finiteN3Residual x y c i‖ <
                  101 / 100 * (35 / 65536) * (4 * ‖x - y‖ ^ 2 / (‖x‖ * ‖y‖ * ‖c‖ ^ 2)) ^ 3 /
                    (4 * ‖D1Bound5.finiteN3RowFactor x y i‖)
D1Bound5.finiteN3_residual_norm_lt : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        x ≠ y →
          ‖x‖ ≤ ‖y‖ →
            1000 ≤ ‖x‖ * ‖c‖ →
              ∀ (i : Fin 3), ‖D1Bound5.finiteN3Residual x y c i‖ < 35 / 32 * ‖y‖ ^ 3 / (‖x‖ ^ 4 * ‖c‖ ^ 6)
D1Bound5.finiteN3Residual_explicit : ∀ (x y c : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        ∀ (i : Fin 3),
          D1Bound5.finiteN3Residual x y c i =
            D1Bound5.finiteN3Constant x y c i + x * D1Bound5.finiteN3Left x y c i * (1 + 1 / (x * c)) ^ (1 / 2) +
              y * D1Bound5.finiteN3Right x y c i * (1 + 1 / (y * c)) ^ (1 / 2)
@D1Bound5.finiteN3RowForm_explicit : ∀ {R : Type u_1} [inst : CommRing R] (x y c z sX sY : R) (i : Fin 3),
  D1Bound5.finiteN3RowForm x y c z sX sY i =
    D1Bound5.finiteN3Constant x y c i * z + D1Bound5.finiteN3Left x y c i * sX + D1Bound5.finiteN3Right x y c i * sY
D1Bound5.finiteN3RowForm_norm_lt : ∀ (x y c z sX sY : ℂ),
  x ≠ 0 →
    y ≠ 0 →
      c ≠ 0 →
        z ≠ 0 →
          x ≠ y →
            ‖x‖ ≤ ‖y‖ →
              1000 ≤ ‖x‖ * ‖c‖ →
                ‖(1 + 1 / (x * c)) ^ (1 / 2) - sX / (x * z)‖ < 101 / 100 * ‖c‖ / (‖x‖ * ‖z‖ ^ 2) →
                  ‖(1 + 1 / (y * c)) ^ (1 / 2) - sY / (y * z)‖ < 101 / 100 * ‖c‖ / (‖y‖ * ‖z‖ ^ 2) →
                    ∀ (i : Fin 3),
                      ‖D1Bound5.finiteN3RowForm x y c z sX sY i‖ <
                        4143 * ‖y‖ ^ 7 * ‖c‖ ^ 4 / ‖z‖ + 35 / 32 * ‖y‖ ^ 3 * ‖z‖ / (‖x‖ ^ 4 * ‖c‖ ^ 6)
@D1Bound5.full_ring_finiteN3_integer : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (x y c d rX rY vX vY z : 𝓞 K),
      x ≠ 0 →
        y ≠ 0 →
          c ≠ 0 →
            d ≠ 0 →
              x ≠ y →
                rX ^ 2 = x * c + 1 →
                  rY ^ 2 = y * c + 1 →
                    vX ^ 2 = x * d + 1 →
                      vY ^ 2 = y * d + 1 →
                        z ^ 2 = c * d + 1 →
                          ‖phi ↑x‖ ≤ ‖phi ↑y‖ →
                            1000 ≤ ‖phi ↑x‖ * ‖phi ↑c‖ →
                              200 * ‖phi ↑y‖ ≤ ‖phi ↑c‖ →
                                1 <
                                  4143 * ‖phi ↑y‖ ^ 7 * ‖phi ↑c‖ ^ 4 / ‖phi ↑z‖ +
                                    35 / 32 * ‖phi ↑y‖ ^ 3 * ‖phi ↑z‖ / (‖phi ↑x‖ ^ 4 * ‖phi ↑c‖ ^ 6)
@D1Bound5.IsD1Tuple.finiteN3_inequality : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 4 → 𝓞 K),
      D1Bound5.IsD1Tuple t →
        ‖phi ↑(t 0)‖ ≤ ‖phi ↑(t 1)‖ →
          1000 ≤ ‖phi ↑(t 0)‖ * ‖phi ↑(t 2)‖ →
            200 * ‖phi ↑(t 1)‖ ≤ ‖phi ↑(t 2)‖ →
              ∃ z,
                z ^ 2 = t 2 * t 3 + 1 ∧
                  1 <
                    4143 * ‖phi ↑(t 1)‖ ^ 7 * ‖phi ↑(t 2)‖ ^ 4 / ‖phi ↑z‖ +
                      35 / 32 * ‖phi ↑(t 1)‖ ^ 3 * ‖phi ↑z‖ / (‖phi ↑(t 0)‖ ^ 4 * ‖phi ↑(t 2)‖ ^ 6)
@D1Bound5.IsD1Tuple.finiteN3_closed_interval_excluded : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 4 → 𝓞 K),
      D1Bound5.IsD1Tuple t →
        ‖phi ↑(t 0)‖ ≤ ‖phi ↑(t 1)‖ →
          1000 ≤ ‖phi ↑(t 0)‖ * ‖phi ↑(t 2)‖ →
            200 * ‖phi ↑(t 1)‖ ≤ ‖phi ↑(t 2)‖ →
              ‖phi ↑(t 2)‖ ≤ ‖phi ↑(t 3)‖ →
                4 * 4143 ^ 2 * ‖phi ↑(t 1)‖ ^ 14 * ‖phi ↑(t 2)‖ ^ 7 / (1 - 1 / 4000) ≤ ‖phi ↑(t 3)‖ →
                  ‖phi ↑(t 3)‖ ≤
                      256 * ‖phi ↑(t 0)‖ ^ 8 * ‖phi ↑(t 2)‖ ^ 11 / (1225 * ‖phi ↑(t 1)‖ ^ 6 * (1 + 1 / 4000)) →
                    False
