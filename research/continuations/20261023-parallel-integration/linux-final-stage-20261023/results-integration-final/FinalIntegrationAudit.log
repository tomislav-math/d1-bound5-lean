def D1Bound5.MainStatement.{u} : Prop :=
∀ (K : Type u) [inst : Field K] [inst_1 : NumberField K] [NumberField.IsTotallyComplex K],
  finrank ℚ K = 2 → ∀ (A : Finset (𝓞 K)), D1Bound5.IsD1 A → A.card ≤ 5
theorem D1Bound5.main_statement.{u} : D1Bound5.MainStatement :=
D1Bound5.mainStatement_iff_three_ordered_cases.mpr
  fun K [Field K] [NumberField K] [NumberField.IsTotallyComplex K] hK phi =>
  ⟨fun t ht hmon hlarge => D1Bound5.IsD1Tuple.all_large_impossible hK phi t ht hmon hlarge,
    ⟨fun t ht hmon hfirst hsecond => D1Bound5.IsD1Tuple.not_one_small hK phi t ht hmon hfirst hsecond,
      fun t ht hmon hsecond =>
      if hthird : ‖phi ↑(t 2)‖ < 3 then D1Bound5.IsD1Tuple.not_three_small hK phi t ht hmon hthird
      else
        if hprod : t 0 * t 1 + 1 = 0 then D1Bound5.IsD1Tuple.degenerate_first_pair_impossible hK phi t ht hmon hprod
        else
          D1Bound5.IsD1Tuple.two_small_nondegenerate_impossible hK phi t ht hmon hsecond (le_of_not_gt hthird) hprod⟩⟩
'D1Bound5.main_statement' depends on axioms: [propext, Classical.choice, Quot.sound]
