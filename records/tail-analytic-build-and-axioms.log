'D1Bound5.irregular_quadratic' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.irregular_quadratic : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (φ : K →+* ℂ) (a b c r s t : NumberField.RingOfIntegers K),
      r ^ 2 = a * b + 1 →
        s ^ 2 = a * c + 1 →
          t ^ 2 = b * c + 1 →
            D1Bound5.regularDefect a b c ≠ 0 →
              have f := φ.comp (algebraMap (NumberField.RingOfIntegers K) K);
              0 ≤
                ‖f c‖ ^ 2 - 2 * (‖1 + 2 * f a * f b‖ - ‖f a + f b‖) * ‖f c‖ + ‖(f a - f b) ^ 2 - 4‖ + 2 * ‖f a + f b‖ +
                  1
'D1Bound5.irregular_growth' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.irregular_growth : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (φ : K →+* ℂ) (a b c r s t : NumberField.RingOfIntegers K),
