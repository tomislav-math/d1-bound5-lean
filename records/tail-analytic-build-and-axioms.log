@D1Bound5.tail_irregular_of_four_le : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (a b c d : NumberField.RingOfIntegers K),
      a ≠ 0 →
        (∃ u, u ^ 2 = a * b + 1) →
          (∃ v, v ^ 2 = a * c + 1) →
            (∃ w, w ^ 2 = a * d + 1) →
              (∃ r, r ^ 2 = b * c + 1) →
                ‖phi ↑a‖ ≤ ‖phi ↑b‖ →
                  3 ≤ ‖phi ↑b‖ → 4 ≤ ‖phi ↑c‖ → ‖phi ↑c‖ ≤ ‖phi ↑d‖ → D1Bound5.regularDefect b c d ≠ 0
@D1Bound5.IsD1Tuple.tail_irregular_and_growth_of_four_le : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 4 → NumberField.RingOfIntegers K),
      D1Bound5.IsD1Tuple t →
        (Monotone fun i => ‖phi ↑(t i)‖) →
          3 ≤ ‖phi ↑(t 1)‖ →
            4 ≤ ‖phi ↑(t 2)‖ →
