def D1Bound5.MainStatement.{u} : Prop :=
∀ (K : Type u) [inst : Field K] [inst_1 : NumberField K] [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 → ∀ (A : Finset (NumberField.RingOfIntegers K)), D1Bound5.IsD1 A → A.card ≤ 5
def D1Bound5.IsD1.{u_1} : {R : Type u_1} → [CommRing R] → Finset R → Prop :=
fun {R} [CommRing R] A => (∀ x ∈ A, x ≠ 0) ∧ ∀ x ∈ A, ∀ y ∈ A, x ≠ y → ∃ r, r * r = x * y + 1
def D1Bound5.IsD1Tuple.{u_1} : {R : Type u_1} → [CommRing R] → {n : ℕ} → (Fin n → R) → Prop :=
fun {R} [CommRing R] {n} f =>
  Function.Injective f ∧ (∀ (i : Fin n), f i ≠ 0) ∧ ∀ (i j : Fin n), i ≠ j → ∃ r, r * r = f i * f j + 1
'D1Bound5.exists_full_integer_coordinates' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.exists_full_integer_coordinates : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∃ d,
      0 < d ∧
        Squarefree d ∧
          (d % 4 = 3 ∧ Nonempty (D1Bound5.QuadInt 1 ((d + 1) / 4) ≃+* NumberField.RingOfIntegers K) ∨
            d % 4 ≠ 3 ∧ Nonempty (D1Bound5.QuadInt 0 d ≃+* NumberField.RingOfIntegers K))
'D1Bound5.norm_sq_eq_absolute_norm' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.norm_sq_eq_absolute_norm : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 → ∀ (φ : K →+* ℂ) (x : NumberField.RingOfIntegers K), ‖φ ↑x‖ ^ 2 = ↑((Algebra.norm ℤ) x)
'D1Bound5.full_ring_one_three_common_extension_is_integer' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.full_ring_one_three_common_extension_is_integer : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ {z : NumberField.RingOfIntegers K}, (∃ r, r * r = z + 1) → (∃ s, s * s = 3 * z + 1) → ∃ n, z = ↑n
'D1Bound5.irregular_quadratic' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.irregular_quadratic : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (φ : K →+* ℂ) (a b c r s t : NumberField.RingOfIntegers K),
      r ^ 2 = a * b + 1 →
        s ^ 2 = a * c + 1 →
          t ^ 2 = b * c + 1 →
            D1Bound5.regularDefect a b c ≠ 0 →
              have f := φ.comp (algebraMap (NumberField.RingOfIntegers K) K);
              0 ≤
                ‖f c‖ ^ 2 - 2 * (‖1 + 2 * f a * f b‖ - ‖f a + f b‖) * ‖f c‖ + ‖(f a - f b) ^ 2 - 4‖ + 2 * ‖f a + f b‖ +
                  1
'D1Bound5.irregular_growth' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.irregular_growth : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (φ : K →+* ℂ) (a b c r s t : NumberField.RingOfIntegers K),
      r ^ 2 = a * b + 1 →
        s ^ 2 = a * c + 1 →
          t ^ 2 = b * c + 1 →
            D1Bound5.regularDefect a b c ≠ 0 →
              3 ≤ ‖φ ↑a‖ → ‖φ ↑a‖ ≤ ‖φ ↑b‖ → ‖φ ↑b‖ ≤ ‖φ ↑c‖ → 2 * ‖φ ↑a‖ * ‖φ ↑b‖ < ‖φ ↑c‖
'D1Bound5.QuadInt.hasSquareRoot_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.QuadInt.hasSquareRoot_iff : ∀ {tau nu : ℤ},
  0 < D1Bound5.QuadInt.discriminant tau nu → ∀ (z : D1Bound5.QuadInt tau nu), z.hasSquareRoot = true ↔ ∃ r, r * r = z
'D1Bound5.QuadInt.mem_disk_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.QuadInt.mem_disk_iff : ∀ {tau nu : ℤ},
  0 < D1Bound5.QuadInt.discriminant tau nu →
    ∀ (M : ℤ) (z : D1Bound5.QuadInt tau nu), z ∈ D1Bound5.QuadInt.disk tau nu M ↔ QuadraticAlgebra.norm z ≤ M
'D1Bound5.smallTailCheck_of_explicit_list' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.smallTailCheck_of_explicit_list : ∀ {tau nu : ℤ} (xs : List (D1Bound5.QuadInt tau nu)),
  (∀ z ∈ D1Bound5.QuadInt.disk tau nu 15, z ∈ xs) → D1Bound5.tailListBool xs = true → D1Bound5.SmallTailCheck tau nu
'D1Bound5.smallTailCheck_rectangular' depends on axioms: [propext, Classical.choice, Quot.sound]
D1Bound5.smallTailCheck_rectangular : ∀ (tau nu : ℤ),
  tau = 0 ∨ tau = 1 → 1 ≤ nu → nu ≤ 15 → 0 < D1Bound5.QuadInt.discriminant tau nu → D1Bound5.SmallTailCheck tau nu
'D1Bound5.IsD1Tuple.tail_irregular_and_growth' depends on axioms: [propext, Classical.choice, Quot.sound]
@D1Bound5.IsD1Tuple.tail_irregular_and_growth : ∀ {K : Type u_1} [inst : Field K] [inst_1 : NumberField K]
  [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 →
    ∀ (phi : K →+* ℂ) (t : Fin 4 → NumberField.RingOfIntegers K),
      D1Bound5.IsD1Tuple t →
