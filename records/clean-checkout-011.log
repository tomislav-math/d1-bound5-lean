def D1Bound5.MainStatement.{u} : Prop :=
∀ (K : Type u) [inst : Field K] [inst_1 : NumberField K] [NumberField.IsTotallyComplex K],
  Module.finrank ℚ K = 2 → ∀ (A : Finset (NumberField.RingOfIntegers K)), D1Bound5.IsD1 A → A.card ≤ 5
def D1Bound5.IsD1.{u_1} : {R : Type u_1} → [CommRing R] → Finset R → Prop :=
fun {R} [CommRing R] A => (∀ x ∈ A, x ≠ 0) ∧ ∀ x ∈ A, ∀ y ∈ A, x ≠ y → ∃ r, r * r = x * y + 1
def D1Bound5.IsD1Tuple.{u_1} : {R : Type u_1} → [CommRing R] → {n : ℕ} → (Fin n → R) → Prop :=
fun {R} [CommRing R] {n} f =>
  Function.Injective f ∧ (∀ (i : Fin n), f i ≠ 0) ∧ ∀ (i j : Fin n), i ≠ j → ∃ r, r * r = f i * f j + 1
